@inherits LayoutComponentBase
@implements IDisposable
@inject ThemeState Theme
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IDialogService Dialogs
@inject ISnackbar Snack
@inject PowerOperations PowerOps

<MudThemeProvider IsDarkMode="@Theme.IsDark" />
<MudPopoverProvider />
<MudDialogProvider DefaultFocus="DefaultFocus.FirstChild" />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudLink Href="/" Color="Color.Inherit" Underline="Underline.None" Class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Storage" Class="mr-2" />
            <MudText Typo="Typo.h6">UrsaNAS</MudText>
        </MudLink>
        <MudSpacer />
        <AuthorizeView>
            @* Tous les comptes de l'interface sont des administrateurs : l'icône n'existe que pour une session ouverte. *@
            <MudTooltip Text="@L["Terminal"]">
                <MudIconButton Icon="@Icons.Material.Filled.Terminal" Color="Color.Inherit" OnClick="OpenTerminal" />
            </MudTooltip>
            <MudText Typo="Typo.body2" Class="mr-2">@context.User.Identity?.Name</MudText>
            <MudTooltip Text="@L["Sign out"]">
                <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="Logout" />
            </MudTooltip>
        </AuthorizeView>
        <MudMenu Icon="@Icons.Material.Filled.Translate" Color="Color.Inherit" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <MudMenuItem OnClick='() => SetLanguage("en")'>English @(L.Lang == "en" ? "✓" : "")</MudMenuItem>
            <MudMenuItem OnClick='() => SetLanguage("fr")'>Français @(L.Lang == "fr" ? "✓" : "")</MudMenuItem>
        </MudMenu>
        <MudMenu Icon="@(Theme.IsDark ? Icons.Material.Filled.DarkMode : Icons.Material.Filled.LightMode)" Color="Color.Inherit"
                 AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <MudMenuItem Icon="@Icons.Material.Filled.LightMode" OnClick="() => SetTheme(false)">@L["Light theme"] @(Theme.IsDark ? "" : "✓")</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.DarkMode" OnClick="() => SetTheme(true)">@L["Dark theme"] @(Theme.IsDark ? "✓" : "")</MudMenuItem>
        </MudMenu>
        <AuthorizeView>
            <MudMenu Icon="@Icons.Material.Filled.PowerSettingsNew" Color="Color.Inherit" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <MudMenuItem Icon="@Icons.Material.Filled.RestartAlt" OnClick="() => Power(true)">@L["Restart"]</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.PowerOff" OnClick="() => Power(false)">@L["Shutdown"]</MudMenuItem>
            </MudMenu>
        </AuthorizeView>
    </MudAppBar>
    @* Plus de menu latéral : les fonctions sont les icônes du bureau (page d'accueil) ; le bouton « Bureau » de la barre des tâches y revient. *@
    <MudMainContent Class="pt-20 px-4 pb-16">@Body</MudMainContent> @* pt-20 : dégage la barre d'application fixe ; pb-16 : la barre des tâches *@
    <DesktopHost />
    <DesktopTaskbar />
</MudLayout>

@code {
    protected override void OnInitialized()
    {
        Theme.Changed += OnThemeChanged;
    }
    void OnThemeChanged() => InvokeAsync(StateHasChanged);

    // Le terminal s'ouvre dans sa propre fenêtre, comme la console d'une machine virtuelle.
    async Task OpenTerminal() => await JS.InvokeVoidAsync("open", "/terminal/window", "ursanas-terminal", "popup,width=1000,height=640");

    // Rechargement complet : /logout est une vraie réponse HTTP qui supprime le cookie, pas une page du routeur.
    void Logout() => Nav.NavigateTo("/logout", forceLoad: true);

    // /lang pose le cookie de langue puis revient ici : rechargement complet pour que le circuit reparte dans la nouvelle langue.
    void SetLanguage(string code) =>
        Nav.NavigateTo($"/lang/{code}?returnUrl={Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri))}", forceLoad: true);

    // Arrêt ou redémarrage du NAS, après confirmation : l'interface devient injoignable ensuite.
    async Task Power(bool reboot)
    {
        var ok = await Dialogs.ShowMessageBoxAsync(reboot ? L["Restart"] : L["Shutdown"],
            reboot ? L["Restart the NAS now? The interface will be unreachable for a few minutes."] : L["Shut down the NAS now? It will have to be turned on again by hand."],
            yesText: reboot ? L["Restart"] : L["Shutdown"], cancelText: L["Cancel"]);
        if (ok != true) return;
        try { await PowerOps.PowerAsync(reboot); Snack.Add(reboot ? L["The NAS is restarting."] : L["The NAS is shutting down."], Severity.Warning); }
        catch (AgentException e) { Snack.Add(L.Translate(e.Message), Severity.Error); }
        catch (HttpRequestException) { Snack.Add(L["Agent unreachable."], Severity.Error); }
    }

    async Task SetTheme(bool dark)
    {
        Theme.Set(dark);
        await JS.InvokeVoidAsync("ursanasSetTheme", dark ? "dark" : "light");
    }

    public void Dispose()
    {
        Theme.Changed -= OnThemeChanged;
    }
}
