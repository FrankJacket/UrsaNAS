@inherits LayoutComponentBase
@implements IDisposable
@inject ThemeState Theme
@inject Nas.Web.Alerting.AlertState Alerts
@inject IJSRuntime JS
@inject NavigationManager Nav

<MudThemeProvider IsDarkMode="@Theme.IsDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIcon Icon="@Icons.Material.Filled.Storage" Class="mr-2" />
        <MudText Typo="Typo.h6">UrsaNAS</MudText>
        <MudSpacer />
        <AuthorizeView>
            <MudText Typo="Typo.body2" Class="mr-2">@context.User.Identity?.Name</MudText>
            <MudTooltip Text="@L["Sign out"]">
                <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="Logout" />
            </MudTooltip>
        </AuthorizeView>
        <MudMenu Icon="@Icons.Material.Filled.Translate" Color="Color.Inherit" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <MudMenuItem OnClick='() => SetLanguage("en")'>English @(L.Lang == "en" ? "✓" : "")</MudMenuItem>
            <MudMenuItem OnClick='() => SetLanguage("fr")'>Français @(L.Lang == "fr" ? "✓" : "")</MudMenuItem>
        </MudMenu>
        <MudMenu Icon="@(Theme.IsDark ? Icons.Material.Filled.DarkMode : Icons.Material.Filled.LightMode)" Color="Color.Inherit"
                 AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <MudMenuItem Icon="@Icons.Material.Filled.LightMode" OnClick="() => SetTheme(false)">@L["Light theme"] @(Theme.IsDark ? "" : "✓")</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.DarkMode" OnClick="() => SetTheme(true)">@L["Dark theme"] @(Theme.IsDark ? "✓" : "")</MudMenuItem>
        </MudMenu>
    </MudAppBar>
    <MudDrawer Open="true" Elevation="0" Variant="DrawerVariant.Persistent">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">@L["Dashboard"]</MudNavLink>
            <MudNavGroup Title="@L["Storage"]" Icon="@Icons.Material.Filled.Storage" Expanded="false">
                <MudNavLink Href="/disks" Icon="@Icons.Material.Filled.Dns">@L["Disks"]</MudNavLink>
                <MudNavLink Href="/pools" Icon="@Icons.Material.Filled.Layers">@L["ZFS pools"]</MudNavLink>
                <MudNavLink Href="/datasets" Icon="@Icons.Material.Filled.FolderCopy">@L["Datasets"]</MudNavLink>
            </MudNavGroup>
            <MudNavGroup Title="@L["Sharing"]" Icon="@Icons.Material.Filled.FolderShared" Expanded="false">
                <MudNavLink Href="/shares" Icon="@Icons.Material.Filled.Share">@L["Shares"]</MudNavLink>
                <MudNavLink Href="/folders" Icon="@Icons.Material.Filled.Folder">@L["File Manager"]</MudNavLink>
                <MudNavLink Href="/services" Icon="@Icons.Material.Filled.SettingsEthernet">@L["Services"]</MudNavLink>
            </MudNavGroup>
            <MudNavGroup Title="@L["Accounts"]" Icon="@Icons.Material.Filled.ManageAccounts" Expanded="false">
                <MudNavLink Href="/users" Icon="@Icons.Material.Filled.People">@L["Users"]</MudNavLink>
                <MudNavLink Href="/groups" Icon="@Icons.Material.Filled.Groups">@L["Groups"]</MudNavLink>
                <MudNavLink Href="/admins" Icon="@Icons.Material.Filled.AdminPanelSettings">@L["Administrators"]</MudNavLink>
            </MudNavGroup>
            <MudNavGroup Title="@L["Monitoring"]" Icon="@Icons.Material.Filled.MonitorHeart" Expanded="false">
                <MudNavLink Href="/alerts" Icon="@Icons.Material.Filled.NotificationsActive">
                    @L["Alerts"]
                    @if (Alerts.Count > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Color="@(Alerts.CriticalCount > 0 ? Color.Error : Color.Warning)" Class="ml-2">@Alerts.Count</MudChip>
                    }
                </MudNavLink>
                <MudNavLink Href="/journal" Icon="@Icons.Material.Filled.History">@L["Audit log"]</MudNavLink>
            </MudNavGroup>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent Class="pt-20 px-4 pb-4">@Body</MudMainContent> @* pt-20 : dégage la barre d'application fixe *@
</MudLayout>

@code {
    protected override void OnInitialized()
    {
        Theme.Changed += OnThemeChanged;
        Alerts.Changed += OnThemeChanged; // même rafraîchissement : la pastille d'alertes suit le contrôle périodique
    }
    void OnThemeChanged() => InvokeAsync(StateHasChanged);

    // Rechargement complet : /logout est une vraie réponse HTTP qui supprime le cookie, pas une page du routeur.
    void Logout() => Nav.NavigateTo("/logout", forceLoad: true);

    // /lang pose le cookie de langue puis revient ici : rechargement complet pour que le circuit reparte dans la nouvelle langue.
    void SetLanguage(string code) =>
        Nav.NavigateTo($"/lang/{code}?returnUrl={Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri))}", forceLoad: true);

    async Task SetTheme(bool dark)
    {
        Theme.Set(dark);
        await JS.InvokeVoidAsync("ursanasSetTheme", dark ? "dark" : "light");
    }

    public void Dispose()
    {
        Theme.Changed -= OnThemeChanged;
        Alerts.Changed -= OnThemeChanged;
    }
}
