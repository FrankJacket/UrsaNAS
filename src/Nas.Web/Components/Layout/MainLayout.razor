@inherits LayoutComponentBase
@implements IDisposable
@inject ThemeState Theme
@inject Nas.Web.Alerting.AlertState Alerts
@inject IJSRuntime JS
@inject NavigationManager Nav

<MudThemeProvider IsDarkMode="@Theme.IsDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIcon Icon="@Icons.Material.Filled.Storage" Class="mr-2" />
        <MudText Typo="Typo.h6">UrsaNAS</MudText>
        <MudSpacer />
        <AuthorizeView>
            <MudText Typo="Typo.body2" Class="mr-2">@context.User.Identity?.Name</MudText>
            <MudTooltip Text="Se déconnecter">
                <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="Logout" />
            </MudTooltip>
        </AuthorizeView>
        <MudMenu Icon="@(Theme.IsDark ? Icons.Material.Filled.DarkMode : Icons.Material.Filled.LightMode)" Color="Color.Inherit"
                 AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <MudMenuItem Icon="@Icons.Material.Filled.LightMode" OnClick="() => SetTheme(false)">Thème clair @(Theme.IsDark ? "" : "✓")</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.DarkMode" OnClick="() => SetTheme(true)">Thème sombre @(Theme.IsDark ? "✓" : "")</MudMenuItem>
        </MudMenu>
    </MudAppBar>
    <MudDrawer Open="true" Elevation="0" Variant="DrawerVariant.Persistent">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dns">Disques</MudNavLink>
            <MudNavLink Href="/pools" Icon="@Icons.Material.Filled.Layers">Pools ZFS</MudNavLink>
            <MudNavLink Href="/datasets" Icon="@Icons.Material.Filled.FolderCopy">Jeux de données</MudNavLink>
            <MudNavLink Href="/users" Icon="@Icons.Material.Filled.People">Utilisateurs</MudNavLink>
            <MudNavLink Href="/shares" Icon="@Icons.Material.Filled.FolderShared">Partages</MudNavLink>
            <MudNavLink Href="/alerts" Icon="@Icons.Material.Filled.NotificationsActive">
                Alertes
                @if (Alerts.Count > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="@(Alerts.CriticalCount > 0 ? Color.Error : Color.Warning)" Class="ml-2">@Alerts.Count</MudChip>
                }
            </MudNavLink>
            <MudNavLink Href="/admins" Icon="@Icons.Material.Filled.AdminPanelSettings">Administrateurs</MudNavLink>
            <MudNavLink Href="/journal" Icon="@Icons.Material.Filled.History">Journal</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent Class="pt-20 px-4 pb-4">@Body</MudMainContent> @* pt-20 : dégage la barre d'application fixe *@
</MudLayout>

@code {
    protected override void OnInitialized()
    {
        Theme.Changed += OnThemeChanged;
        Alerts.Changed += OnThemeChanged; // même rafraîchissement : la pastille d'alertes suit le contrôle périodique
    }
    void OnThemeChanged() => InvokeAsync(StateHasChanged);

    // Rechargement complet : /logout est une vraie réponse HTTP qui supprime le cookie, pas une page du routeur.
    void Logout() => Nav.NavigateTo("/logout", forceLoad: true);

    async Task SetTheme(bool dark)
    {
        Theme.Set(dark);
        await JS.InvokeVoidAsync("ursanasSetTheme", dark ? "dark" : "light");
    }

    public void Dispose()
    {
        Theme.Changed -= OnThemeChanged;
        Alerts.Changed -= OnThemeChanged;
    }
}
