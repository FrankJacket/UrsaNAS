@inherits LayoutComponentBase

@* Mise en page des pages publiques (connexion, installation) : rien d'interactif, aucun menu. *@
<style>
    body { margin: 0; font-family: Roboto, Helvetica, Arial, sans-serif; background: #f5f5f5; color: #212121; }
    .auth { max-width: 380px; margin: 10vh auto; padding: 2rem; background: #fff; border-radius: 8px; box-shadow: 0 2px 12px rgba(0,0,0,.15); }
    .lang { text-align: center; font-size: .85rem; }
    .lang a { color: #594ae2; text-decoration: none; }
    .auth h1 { margin: 0 0 .25rem; font-size: 1.6rem; }
    .auth p.hint { margin: 0 0 1.5rem; color: #666; font-size: .9rem; }
    .auth label { display: block; margin: 1rem 0 .25rem; font-size: .85rem; color: #555; }
    .auth input { width: 100%; box-sizing: border-box; padding: .6rem; font-size: 1rem; border: 1px solid #bbb; border-radius: 4px; background: #fff; color: #212121; }
    .auth button { margin-top: 1.5rem; width: 100%; padding: .7rem; font-size: 1rem; border: 0; border-radius: 4px; background: #594ae2; color: #fff; cursor: pointer; }
    .auth .error { margin-top: 1rem; padding: .6rem; border-radius: 4px; background: #fdecea; color: #b3261e; font-size: .9rem; }
    @@media (prefers-color-scheme: dark) {
        body { background: #1e1e2d; color: #e0e0e0; }
        .auth { background: #27272f; box-shadow: none; }
        .auth p.hint, .auth label { color: #aaa; }
        .auth input { background: #1e1e2d; color: #e0e0e0; border-color: #555; }
        .auth .error { background: #4a1f1c; color: #ffb4ab; }
    }
</style>
<div class="auth">@Body</div>
<p class="lang">
    <a href="/lang/en?returnUrl=@Uri.EscapeDataString(returnUrl)">English</a> ·
    <a href="/lang/fr?returnUrl=@Uri.EscapeDataString(returnUrl)">Français</a>
</p>

@code {
    [CascadingParameter] HttpContext? HttpContext { get; set; }
    string returnUrl => HttpContext?.Request.Path.Value is { Length: > 0 } p ? p : "/";
}
