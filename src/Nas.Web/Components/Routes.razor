@inject ThemeState Theme

<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                <div style="padding:2rem;font-family:Roboto,sans-serif">
                    <h2>Session expirée</h2>
                    <p>Tu n'es plus connecté. <a href="/login" data-enhance-nav="false">Se reconnecter</a></p>
                </div>
            </NotAuthorized>
        </AuthorizeRouteView>
    </Found>
    <NotFound><MudText Class="pa-4">Page introuvable.</MudText></NotFound>
</Router>

@code {
    /// <summary>"dark" ou "light", lu dans le cookie de thème par App.razor.</summary>
    [Parameter] public string InitialTheme { get; set; } = "light";

    /// <summary>Identifiant du préréglage de couleurs, lu dans le cookie par App.razor.</summary>
    [Parameter] public string InitialColor { get; set; } = "default";

    /// <summary>Fond d'écran choisi, lu dans le cookie par App.razor.</summary>
    [Parameter] public string InitialWallpaper { get; set; } = "default";

    protected override void OnInitialized()
    {
        Theme.Set(InitialTheme == "dark");
        Theme.SetPreset(ThemePreset.Find(InitialColor));
        Theme.SetWallpaper(InitialWallpaper);
    }
}
