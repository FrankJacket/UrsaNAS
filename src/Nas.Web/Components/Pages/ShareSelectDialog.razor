@* Choix d'un partage dans une liste ; se ferme avec son nom. *@
<MudDialog>
    <DialogContent>
        <MudSelect T="string" @bind-Value="share" Label="@L["Share"]" AutoFocus="true">
            @foreach (var s in Shares)
            {
                <MudSelectItem T="string" Value="@s">@s</MudSelectItem>
            }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="() => Dialog.Close(DialogResult.Ok(share))" Disabled="@string.IsNullOrEmpty(share)">@L["Next"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<string> Shares { get; set; } = [];

    string share = "";

    protected override void OnInitialized() => share = Shares.FirstOrDefault() ?? "";
}
