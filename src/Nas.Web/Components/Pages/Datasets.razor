@page "/datasets"
@inherits AutoRefreshBase
@inject AgentClient Agent
@inject NasOperations Ops
@inject IDialogService Dialogs
@inject ISnackbar Snack

@if (!InWindow) { <MudText Typo="Typo.h4" Class="mb-4">@L["Datasets"]</MudText> }
@if (error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@error</MudAlert>
}
<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CreateNewFolder" OnClick="Create" Class="mb-4"
           Disabled="@(datasets.Count == 0)">@L["Create a dataset"]</MudButton>
<MudTable Items="datasets" Hover="true" Dense="true" Loading="@(!loaded)" Class="mb-8 desk-grow">
    <HeaderContent><MudTh>@L["Name"]</MudTh><MudTh>@L["Used"]</MudTh><MudTh>@L["Available"]</MudTh><MudTh>@L["Mounted on"]</MudTh><MudTh></MudTh></HeaderContent>
    <RowTemplate>
        <MudTd>@context.Name</MudTd>
        <MudTd>@Fmt.Size(context.UsedBytes, L.Lang)</MudTd>
        <MudTd>@Fmt.Size(context.AvailBytes, L.Lang)</MudTd>
        <MudTd><code>@context.Mountpoint</code></MudTd>
        <MudTd Style="text-align:right">
            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PhotoCamera" OnClick="() => Snapshot(context)">@L["Snapshot"]</MudButton>
            @if (context.Name.Contains('/'))
            {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="() => Delete(context)">@L["Delete"]</MudButton>
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText Class="pa-4">@L["No datasets: create a pool first."]</MudText></NoRecordsContent>
</MudTable>

<MudText Typo="Typo.h5" Class="mb-2">@L["Snapshots"]</MudText>
<MudTable Items="snapshots" Hover="true" Dense="true" Loading="@(!loaded)" Class="desk-grow">
    <HeaderContent><MudTh>@L["Dataset"]</MudTh><MudTh>@L["Snapshot"]</MudTh><MudTh>@L["Created on"]</MudTh><MudTh>@L["Own space"]</MudTh><MudTh></MudTh></HeaderContent>
    <RowTemplate>
        <MudTd>@context.Dataset</MudTd>
        <MudTd>@context.Snapshot</MudTd>
        <MudTd>@Fmt.Dt(context.Created.UtcDateTime)</MudTd>
        <MudTd>@Fmt.Size(context.UsedBytes, L.Lang)</MudTd>
        <MudTd Style="text-align:right">
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="() => DeleteSnapshot(context)">@L["Delete"]</MudButton>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText Class="pa-4">@L["No snapshots."]</MudText></NoRecordsContent>
</MudTable>

@code {
    /// <summary>Vrai quand la page est affichée dans une fenêtre du bureau : le titre est alors celui de la fenêtre.</summary>
    [CascadingParameter(Name = "InWindow")] bool InWindow { get; set; }

    IReadOnlyList<DatasetInfo> datasets = [];
    IReadOnlyList<SnapshotInfo> snapshots = [];
    string? error;
    bool loaded;

    static readonly DialogOptions Options = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true, BackdropClick = false };

    protected override async Task LoadAsync()
    {
        try
        {
            datasets = await Agent.GetDatasetsAsync();
            snapshots = await Agent.GetSnapshotsAsync();
            error = null;
        }
        catch (AgentException e) { error = L.Translate(e.Message); }
        catch (HttpRequestException) { error = L["Agent unreachable: is the ursanas-agent service running?"]; }
        loaded = true;
    }

    async Task Create()
    {
        var parameters = new DialogParameters<DatasetDialog> { { x => x.Parents, datasets.Select(d => d.Name).ToList() } };
        await ShowAsync<DatasetDialog>(L["Create a dataset"], parameters, L["Dataset created."]);
    }

    async Task Snapshot(DatasetInfo d)
    {
        var parameters = new DialogParameters<SnapshotDialog> { { x => x.Dataset, d.Name } };
        await ShowAsync<SnapshotDialog>(L["Create a snapshot"], parameters, L["Snapshot created."]);
    }

    async Task Delete(DatasetInfo d) =>
        await Confirm(L["Delete {0}", d.Name],
            L["Dataset {0} and its files will be deleted. ZFS refuses if the dataset contains snapshots or child datasets: delete them first.", d.Name],
            d.Name, () => Ops.DestroyDatasetAsync(d.Name), L["{0} deleted.", d.Name]);

    async Task DeleteSnapshot(SnapshotInfo s) =>
        await Confirm(L["Delete {0}", s.Name], L["Snapshot {0} will be deleted: you will no longer be able to return to that state.", s.Name],
            s.Snapshot, () => Ops.DestroySnapshotAsync(s.Name), L["Snapshot deleted."]);

    async Task ShowAsync<T>(string title, DialogParameters<T> parameters, string success) where T : Microsoft.AspNetCore.Components.IComponent
    {
        var dialog = await Dialogs.ShowAsync<T>(title, parameters, Options);
        if (await dialog.Result is { Canceled: false })
        {
            Snack.Add(success, Severity.Success);
            await LoadAsync();
        }
    }

    async Task Confirm(string title, string message, string expected, Func<Task> action, string success)
    {
        var parameters = new DialogParameters<ConfirmNameDialog>
        {
            { x => x.Expected, expected }, { x => x.Message, message }, { x => x.Action, action },
        };
        await ShowAsync(title, parameters, success);
    }
}
