@* Partitionne et formate un disque libre (IsDisk) ou formate une partition. Détruit les données : il faut retaper le nom. *@
@inject AgentClient Agent
@inject DiskOperations Ops

<MudDialog>
    <DialogContent>
        @if (error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@error</MudAlert>
        }
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            @(IsDisk ? L["All data on {0} will be erased and the disk will get one partition using all its space.", Path]
                     : L["All data on {0} will be erased.", Path])
        </MudAlert>
        <MudSelect T="string" @bind-Value="fs" Label="@L["File system"]" Disabled="busy">
            @foreach (var f in available)
            {
                <MudSelectItem T="string" Value="@f">@f</MudSelectItem>
            }
        </MudSelect>
        <MudTextField @bind-Value="label" Label="@(fs == "zfs" ? L["Pool name"] : L["Label (optional)"])" Class="mt-2" Immediate="true" Disabled="busy" HelperText="@(fs == "zfs" ? L["Name of the ZFS pool created on the partition (required)."] : L["1 to 11 characters: letters, digits, - and _."])" />
        <MudTextField @bind-Value="confirm" Label="@L["Type {0} to confirm", Path]" Class="mt-2" Immediate="true" Disabled="busy" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()" Disabled="busy">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="Save" Disabled="@(busy || confirm.Trim() != Path || fs.Length == 0 || (fs == "zfs" && label.Trim().Length == 0))">@(busy ? L["In progress…"] : L["Format"])</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter, EditorRequired] public string Path { get; set; } = "";
    [Parameter] public bool IsDisk { get; set; }

    IReadOnlyList<string> available = [];
    string fs = "", label = "", confirm = "";
    string? error;
    bool busy;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            available = await Agent.GetFilesystemsAsync();
            fs = available.Contains("ext4") ? "ext4" : available.FirstOrDefault() ?? "";
        }
        catch (Exception e) when (e is AgentException or HttpRequestException) { error = e is AgentException a ? L.Translate(a.Message) : L["Agent unreachable."]; }
    }

    async Task Save()
    {
        error = null;
        busy = true;
        try
        {
            var l = label.Trim().Length == 0 ? null : label.Trim();
            if (IsDisk) await Ops.PrepareAsync(new PrepareDiskRequest(Path, fs, l));
            else await Ops.FormatAsync(new FormatPartitionRequest(Path, fs, l));
            Dialog.Close(DialogResult.Ok(true));
            return;
        }
        catch (AgentException e) { error = L.Translate(e.Message); }
        catch (HttpRequestException) { error = L["Agent unreachable."]; }
        busy = false;
    }
}
