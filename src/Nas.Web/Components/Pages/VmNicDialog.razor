@inject AgentClient Agent
@inject VmOperations Ops

@* Ajoute une carte réseau, ou (si Nic est donnée) modifie son modèle et son réseau. *@
<MudDialog>
    <DialogContent>
        @if (error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@error</MudAlert>
        }
        <MudSelect T="string" @bind-Value="model" Label="@L["Model"]" Disabled="busy">
            @foreach (var m in Rules.VmNicModels) { <MudSelectItem T="string" Value="@m">@ModelLabel(m)</MudSelectItem> }
        </MudSelect>
        <MudSelect T="string" @bind-Value="bridge" Label="@L["Network"]" Class="mt-2" Disabled="busy">
            <MudSelectItem T="string" Value="@("")">@L["Private libvirt network (NAT)"]</MudSelectItem>
            @foreach (var b in bridges) { <MudSelectItem T="string" Value="@b">@L["Bridge {0} (local network)", b]</MudSelectItem> }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()" Disabled="busy">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="busy">@(busy ? L["In progress…"] : Nic is null ? L["Add"] : L["Save"])</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public VmNic? Nic { get; set; }

    string model = "virtio", bridge = "";
    IReadOnlyList<string> bridges = [];
    string? error;
    bool busy;

    string ModelLabel(string m) => m == "virtio" ? "VirtIO (" + L["fastest, needs drivers on Windows"] + ")" : m;

    protected override async Task OnInitializedAsync()
    {
        if (Nic is not null) (model, bridge) = (Nic.Model, Nic.Bridge ?? "");
        else if (!Rules.VmNicModels.Contains(model)) model = "virtio";
        try { bridges = (await Agent.GetVmStatusAsync()).Bridges; if (Nic is null && bridges.Count > 0) bridge = bridges[0]; }
        catch (Exception e) when (e is AgentException or HttpRequestException) { }
    }

    async Task Save()
    {
        error = null;
        busy = true;
        try
        {
            var b = bridge.Length == 0 ? null : bridge;
            if (Nic is null) await Ops.AddNicAsync(Name, new AddVmNicRequest(model, b));
            else await Ops.UpdateNicAsync(Name, new UpdateVmNicRequest(Nic.Mac, model, b));
            Dialog.Close(DialogResult.Ok(true));
            return;
        }
        catch (AgentException e) { error = L.Translate(e.Message); }
        catch (HttpRequestException) { error = L["Agent unreachable."]; }
        busy = false;
    }
}
