@page "/admins"
@inherits AutoRefreshBase
@inject AdminAccounts Accounts
@inject NasOperations Ops
@inject AuthenticationStateProvider Auth
@inject IDialogService Dialogs
@inject ISnackbar Snack

@if (!InWindow) { <MudText Typo="Typo.h4" Class="mb-4">@L["Administrators"]</MudText> }
<MudText Class="mb-4">@L["Accounts that can sign in to this interface. They are separate from share users (Samba)."]</MudText>
<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="Add" Class="mb-4">@L["Add an administrator"]</MudButton>
<MudTable Items="rows" Class="desk-grow" Hover="true" Dense="true" Loading="@(!loaded)">
    <HeaderContent><MudTh>@L["Username"]</MudTh><MudTh>@L["Created on"]</MudTh><MudTh></MudTh></HeaderContent>
    <RowTemplate>
        <MudTd>@context.Name @if (context.Name == me) { <MudChip T="string" Size="Size.Small" Class="ml-2">@L["you"]</MudChip> }</MudTd>
        <MudTd>@Fmt.Dt(context.CreatedAt)</MudTd>
        <MudTd Style="text-align:right">
            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Key" OnClick="() => Password(context)">@L["Password"]</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                       Disabled="@(context.Name == me)" OnClick="() => Delete(context)">@L["Delete"]</MudButton>
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    /// <summary>Vrai quand la page est affichée dans une fenêtre du bureau : le titre est alors celui de la fenêtre.</summary>
    [CascadingParameter(Name = "InWindow")] bool InWindow { get; set; }

    List<AdminRow> rows = new();
    string me = "";
    bool loaded;

    static readonly DialogOptions Options = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true, BackdropClick = false };

    protected override async Task LoadAsync()
    {
        me = (await Auth.GetAuthenticationStateAsync()).User.Identity?.Name ?? "";
        rows = await Accounts.ListAsync();
        loaded = true;
    }

    async Task Add() => await ShowAsync(new DialogParameters<AdminDialog>(), L["New administrator"], L["Administrator created."]);

    async Task Password(AdminRow a) =>
        await ShowAsync(new DialogParameters<AdminDialog> { { x => x.Existing, a.Name } }, L["Password of {0}", a.Name],
            a.Name == me ? L["Password changed: sign in again."] : L["Password changed."]);

    async Task ShowAsync(DialogParameters<AdminDialog> parameters, string title, string success)
    {
        var dialog = await Dialogs.ShowAsync<AdminDialog>(title, parameters, Options);
        if (await dialog.Result is { Canceled: false })
        {
            Snack.Add(success, Severity.Success);
            await LoadAsync();
        }
    }

    async Task Delete(AdminRow a)
    {
        var ok = await Dialogs.ShowMessageBoxAsync(L["Delete {0}?", a.Name],
            L["This account will no longer be able to sign in, and its open sessions will be closed."], yesText: L["Delete"], cancelText: L["Cancel"]);
        if (ok != true) return;
        try
        {
            await Ops.DeleteAdminAsync(a.Name);
            Snack.Add(L["{0} deleted.", a.Name], Severity.Success);
            await LoadAsync();
        }
        catch (AgentException e) { Snack.Add(L.Translate(e.Message), Severity.Error); }
    }
}
