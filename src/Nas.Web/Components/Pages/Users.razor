@page "/users"
@inherits AutoRefreshBase
@inject AgentClient Agent
@inject NasOperations Ops
@inject IDialogService Dialogs
@inject ISnackbar Snack

@if (!InWindow) { <MudText Typo="Typo.h4" Class="mb-4">@L["Users"]</MudText> }
@if (error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@error</MudAlert>
}
<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="Add" Class="mb-4">@L["Add a user"]</MudButton>
<MudTable Items="users" Class="desk-grow" Hover="true" Dense="true" Loading="@(!loaded)">
    <HeaderContent><MudTh>@L["Name"]</MudTh><MudTh></MudTh></HeaderContent>
    <RowTemplate>
        <MudTd>@context.Name</MudTd>
        <MudTd Style="text-align:right">
            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Key" OnClick="() => ChangePassword(context)">@L["Password"]</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="() => Delete(context)">@L["Delete"]</MudButton>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText Class="pa-4">@L["No users."]</MudText></NoRecordsContent>
</MudTable>

@code {
    /// <summary>Vrai quand la page est affichée dans une fenêtre du bureau : le titre est alors celui de la fenêtre.</summary>
    [CascadingParameter(Name = "InWindow")] bool InWindow { get; set; }

    IReadOnlyList<NasUser> users = [];
    string? error;
    bool loaded;

    protected override async Task LoadAsync()
    {
        try { users = await Agent.GetUsersAsync(); error = null; }
        catch (HttpRequestException) { error = L["Agent unreachable: is the ursanas-agent service running?"]; }
        loaded = true;
    }

    static readonly DialogOptions Options = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true, BackdropClick = false };

    async Task Add()
    {
        var dialog = await Dialogs.ShowAsync<UserDialog>(L["New user"], Options);
        if (await dialog.Result is { Canceled: false })
        {
            Snack.Add(L["User created."], Severity.Success);
            await LoadAsync();
        }
    }

    async Task ChangePassword(NasUser u)
    {
        var parameters = new DialogParameters<PasswordDialog> { { x => x.UserName, u.Name } };
        var dialog = await Dialogs.ShowAsync<PasswordDialog>(L["Password of {0}", u.Name], parameters, Options);
        if (await dialog.Result is { Canceled: false }) Snack.Add(L["Password changed."], Severity.Success);
    }

    async Task Delete(NasUser u)
    {
        var ok = await Dialogs.ShowMessageBoxAsync(L["Delete {0}?", u.Name],
            L["The account and its Samba access are deleted. Files it created remain on the disk."],
            yesText: L["Delete"], cancelText: L["Cancel"]);
        if (ok != true) return;
        try
        {
            await Ops.DeleteUserAsync(u.Name);
            Snack.Add(L["{0} deleted.", u.Name], Severity.Success);
            await LoadAsync();
        }
        catch (AgentException e) { Snack.Add(L.Translate(e.Message), Severity.Error); }
        catch (HttpRequestException) { Snack.Add(L["Agent unreachable."], Severity.Error); }
    }
}
