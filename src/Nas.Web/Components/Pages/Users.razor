@page "/users"
@inherits AutoRefreshBase
@inject AgentClient Agent
@inject NasOperations Ops
@inject IDialogService Dialogs
@inject ISnackbar Snack

<MudText Typo="Typo.h4" Class="mb-4">Utilisateurs</MudText>
@if (error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@error</MudAlert>
}
<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="Add" Class="mb-4">Ajouter un utilisateur</MudButton>
<MudTable Items="users" Hover="true" Dense="true" Loading="@(!loaded)">
    <HeaderContent><MudTh>Nom</MudTh><MudTh></MudTh></HeaderContent>
    <RowTemplate>
        <MudTd>@context.Name</MudTd>
        <MudTd Style="text-align:right">
            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Key" OnClick="() => ChangePassword(context)">Mot de passe</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="() => Delete(context)">Supprimer</MudButton>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText Class="pa-4">Aucun utilisateur.</MudText></NoRecordsContent>
</MudTable>

@code {
    IReadOnlyList<NasUser> users = [];
    string? error;
    bool loaded;

    protected override async Task LoadAsync()
    {
        try { users = await Agent.GetUsersAsync(); error = null; }
        catch (HttpRequestException) { error = "Agent injoignable : le service ursanas-agent est-il démarré ?"; }
        loaded = true;
    }

    static readonly DialogOptions Options = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true, BackdropClick = false };

    async Task Add()
    {
        var dialog = await Dialogs.ShowAsync<UserDialog>("Nouvel utilisateur", Options);
        if (await dialog.Result is { Canceled: false })
        {
            Snack.Add("Utilisateur créé.", Severity.Success);
            await LoadAsync();
        }
    }

    async Task ChangePassword(NasUser u)
    {
        var parameters = new DialogParameters<PasswordDialog> { { x => x.UserName, u.Name } };
        var dialog = await Dialogs.ShowAsync<PasswordDialog>($"Mot de passe de {u.Name}", parameters, Options);
        if (await dialog.Result is { Canceled: false }) Snack.Add("Mot de passe changé.", Severity.Success);
    }

    async Task Delete(NasUser u)
    {
        var ok = await Dialogs.ShowMessageBoxAsync($"Supprimer {u.Name} ?",
            "Le compte et son accès Samba sont supprimés. Les fichiers qu'il a créés restent sur le disque.",
            yesText: "Supprimer", cancelText: "Annuler");
        if (ok != true) return;
        try
        {
            await Ops.DeleteUserAsync(u.Name);
            Snack.Add($"{u.Name} supprimé.", Severity.Success);
            await LoadAsync();
        }
        catch (AgentException e) { Snack.Add(e.Message, Severity.Error); }
        catch (HttpRequestException) { Snack.Add("Agent injoignable.", Severity.Error); }
    }
}
