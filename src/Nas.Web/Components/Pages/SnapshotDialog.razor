@inject NasOperations Ops

<MudDialog>
    <DialogContent>
        @if (error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@error</MudAlert>
        }
        <MudText Class="mb-2">@L["Dataset"] : <b>@Dataset</b></MudText>
        <MudTextField @bind-Value="name" Label="@L["Snapshot name"]" Immediate="true" Disabled="busy" AutoFocus="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()" Disabled="busy">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="busy">@(busy ? L["Creating…"] : L["Create"])</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter, EditorRequired] public string Dataset { get; set; } = "";

    string name = "";

    protected override void OnInitialized() => name = $"{L["manual"]}-{DateTime.Now:yyyyMMdd-HHmmss}";
    string? error;
    bool busy;

    async Task Save()
    {
        error = null;
        busy = true;
        try
        {
            await Ops.CreateSnapshotAsync(Dataset, name.Trim());
            Dialog.Close(DialogResult.Ok(true));
            return;
        }
        catch (AgentException e) { error = L.Translate(e.Message); }
        catch (HttpRequestException) { error = L["Agent unreachable."]; }
        busy = false;
    }
}
