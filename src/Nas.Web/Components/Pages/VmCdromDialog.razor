@inject AgentClient Agent
@inject Repo Repo
@inject VmOperations Ops

<MudDialog>
    <DialogContent>
        @if (error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@error</MudAlert>
        }
        <MudSelect T="string" @bind-Value="iso" Label="@L["Installation image (.iso)"]" Disabled="busy"
                   HelperText="@(isos.Count == 0 && loaded ? L["No .iso file found in the shares or on the mounted disks. Copy one with the File Manager or Windows."] : null)">
            @foreach (var i in isos)
            {
                <MudSelectItem T="string" Value="@(i.Location + "\n" + i.Path)">@((i.Location.Contains('/') ? i.Location : "/" + i.Location) + "/" + i.Path) (@Fmt.Size(i.SizeBytes, L.Lang))</MudSelectItem>
            }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()" Disabled="busy">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="@(busy || iso.Length == 0)">@(busy ? L["In progress…"] : L["Insert"])</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter, EditorRequired] public string Target { get; set; } = "";

    string iso = "";
    IReadOnlyList<IsoFile> isos = [];
    string? error;
    bool busy, loaded;

    protected override async Task OnInitializedAsync()
    {
        try { isos = await Agent.GetIsosAsync((await Repo.GetSharesAsync()).Select(s => s.Name)); }
        catch (Exception e) when (e is AgentException or HttpRequestException) { error = e is AgentException a ? L.Translate(a.Message) : L["Agent unreachable."]; }
        loaded = true;
    }

    async Task Save()
    {
        error = null;
        busy = true;
        try
        {
            var parts = iso.Split('\n', 2);
            await Ops.SetCdromAsync(Name, new SetVmCdromRequest(Target, parts[0], parts.Length > 1 ? parts[1] : ""));
            Dialog.Close(DialogResult.Ok(true));
            return;
        }
        catch (AgentException e) { error = L.Translate(e.Message); }
        catch (HttpRequestException) { error = L["Agent unreachable."]; }
        busy = false;
    }
}
