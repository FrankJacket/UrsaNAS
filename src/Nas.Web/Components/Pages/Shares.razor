@page "/shares"
@inherits AutoRefreshBase
@inject Repo Repo
@inject AgentClient Agent
@inject NasOperations Ops
@inject IDialogService Dialogs
@inject ISnackbar Snack

<MudText Typo="Typo.h4" Class="mb-4">@L["Shares"]</MudText>
<MudStack Row="true" Class="mb-4">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CreateNewFolder" OnClick="Add">@L["Add a share"]</MudButton>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Sync" OnClick="Reapply">@L["Reapply"]</MudButton>
</MudStack>
<MudTable Items="shares" Hover="true" Dense="true" Loading="@(!loaded)">
    <HeaderContent><MudTh>@L["Name"]</MudTh><MudTh>@L["Folder"]</MudTh><MudTh>@L["Access"]</MudTh><MudTh>@L["Users"]</MudTh><MudTh>@L["Description"]</MudTh><MudTh></MudTh></HeaderContent>
    <RowTemplate>
        <MudTd>@context.Name</MudTd>
        <MudTd>
            <code>@PathOf(context)</code>
            @if (context.Dataset is not null)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="ml-2">ZFS</MudChip>
            }
        </MudTd>
        <MudTd>
            @if (context.Acl) { <MudChip T="string" Size="Size.Small" Color="Color.Primary" Href="@($"/permissions?share={context.Name}")">@L["Advanced permissions"]</MudChip> }
            else { <MudChip T="string" Size="Size.Small" Color="@(context.ReadOnly ? Color.Default : Color.Success)">@(context.ReadOnly ? L["Read-only"] : L["Read/write"])</MudChip> }
        </MudTd>
        <MudTd>@(context.Acl ? "—" : string.Join(", ", context.ValidUsers))</MudTd>
        <MudTd>@context.Comment</MudTd>
        <MudTd Style="text-align:right">
            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit" OnClick="() => Edit(context)">@L["Edit"]</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="() => Delete(context)">@L["Delete"]</MudButton>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText Class="pa-4">@L["No shares."]</MudText></NoRecordsContent>
</MudTable>

@code {
    List<ShareDef> shares = new();
    Dictionary<string, string> mountpoints = new();
    bool loaded;

    protected override async Task LoadAsync()
    {
        shares = await Repo.GetSharesAsync();
        await LoadDatasetsAsync();
        loaded = true;
    }

    /// <summary>Jeux de données ZFS et leur point de montage ; vide si ZFS est absent ou l'agent injoignable.</summary>
    async Task<IReadOnlyList<DatasetInfo>> LoadDatasetsAsync()
    {
        try
        {
            var list = await Agent.GetDatasetsAsync();
            mountpoints = list.ToDictionary(d => d.Name, d => d.Mountpoint);
            return list;
        }
        catch (AgentException) { }
        catch (HttpRequestException) { }
        return [];
    }

    string PathOf(ShareDef s) =>
        s.Dataset is null ? $"/srv/nas/{s.Name}" : mountpoints.GetValueOrDefault(s.Dataset, s.Dataset);

    static readonly DialogOptions Options = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true, BackdropClick = false };

    async Task<IReadOnlyList<string>?> UserNames()
    {
        try { return (await Agent.GetUsersAsync()).Select(u => u.Name).ToList(); }
        catch (HttpRequestException) { Snack.Add(L["Agent unreachable."], Severity.Error); return null; }
    }

    async Task Add() => await ShowDialog(null, L["New share"]);
    async Task Edit(ShareDef s) => await ShowDialog(s, L["Edit {0}", s.Name]);

    async Task ShowDialog(ShareDef? existing, string title)
    {
        if (await UserNames() is not { } users) return;
        // Seuls les jeux de données (pas la racine d'un pool) que aucun autre partage n'utilise.
        var taken = shares.Where(s => s.Dataset is not null && s.Name != existing?.Name).Select(s => s.Dataset!).ToHashSet();
        var free = (await LoadDatasetsAsync()).Select(d => d.Name).Where(n => n.Contains('/') && !taken.Contains(n)).ToList();
        IReadOnlyList<string> pools = [];
        try { pools = (await Agent.GetPoolsAsync()).Select(p => p.Name).ToList(); }
        catch (AgentException) { }
        catch (HttpRequestException) { }
        var parameters = new DialogParameters<ShareDialog> { { x => x.Existing, existing }, { x => x.Users, users }, { x => x.Datasets, free }, { x => x.Pools, pools } };
        var dialog = await Dialogs.ShowAsync<ShareDialog>(title, parameters, Options);
        if (await dialog.Result is { Canceled: false } result)
        {
            Snack.Add(L["Share saved."], Severity.Success);
            await LoadAsync();
            // Un nouveau partage n'est accessible à personne : on enchaîne sur ses permissions.
            if (existing is null && result.Data is string created)
            {
                var permParameters = new DialogParameters<FolderPermissionsDialog> { { x => x.Share, created }, { x => x.Path, "" } };
                var big = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true, BackdropClick = false };
                await (await Dialogs.ShowAsync<FolderPermissionsDialog>(L["Permissions of {0}", "/" + created], permParameters, big)).Result;
            }
        }
    }

    async Task Delete(ShareDef s)
    {
        var ok = await Dialogs.ShowMessageBoxAsync(L["Delete share {0}?", s.Name],
            L["The share is no longer reachable over the network. Files remain in {0}.", PathOf(s)],
            yesText: L["Delete"], cancelText: L["Cancel"]);
        if (ok != true) return;
        await Run(() => Ops.DeleteShareAsync(s.Name), L["Share {0} deleted.", s.Name]);
    }

    async Task Reapply() => await Run(Ops.ReapplySharesAsync, L["Shares reapplied."]);

    async Task Run(Func<Task> action, string success)
    {
        try
        {
            await action();
            Snack.Add(success, Severity.Success);
            await LoadAsync();
        }
        catch (AgentException e) { Snack.Add(L.Translate(e.Message), Severity.Error); }
        catch (HttpRequestException) { Snack.Add(L["Agent unreachable."], Severity.Error); }
    }
}
