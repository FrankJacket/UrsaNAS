@page "/folders"
@page "/permissions"
@inject Repo Repo
@inject AgentClient Agent
@inject NasOperations Ops
@inject IDialogService Dialogs
@inject ISnackbar Snack

@if (!InWindow) { <MudText Typo="Typo.h4" Class="mb-4">@L["File Manager"]</MudText> }
@if (error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@error</MudAlert>
}
@if (loaded && allShares.Count == 0 && disks.Count == 0 && remotes.Count == 0)
{
    <MudAlert Severity="Severity.Info">@L["Create a share first."]</MudAlert>
}
else if (loaded)
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3" Wrap="Wrap.Wrap">
        <MudSelect T="string" Value="source" ValueChanged="s => SelectSource(s)" Label="@L["Source"]" Dense="true" Style="width:260px">
            <MudSelectItem T="string" Value="@("Shares")">@L["Shares"]</MudSelectItem>
            <MudSelectItem T="string" Value="@("Mounted drives")">@L["Mounted drives"]</MudSelectItem>
            <MudSelectItem T="string" Value="@("Remote")">@L["Remote"]</MudSelectItem>
        </MudSelect>
    </MudStack>

    <MudStack Row="true" Spacing="2" Class="mb-3" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.CreateNewFolder" OnClick="() => NewFolder(selected)" Disabled="@(!CanFolder)">@L["New folder"]</MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.DriveFileRenameOutline" OnClick="() => Rename(selected)" Disabled="@(!CanModify)">@L["Rename"]</MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.DriveFileMove" OnClick="() => MoveTo(selected, copy: false)" Disabled="@(!CanModify)">@L["Move"]</MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="() => MoveTo(selected, copy: true)" Disabled="@(!CanModify)">@L["Copy"]</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="() => Delete(selected)" Disabled="@(!CanModify)">@L["Delete"]</MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Lock" OnClick="() => OpenPermissions(selected)" Disabled="@(!CanFolder || NoPermissions)">@L["Permissions"]</MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="Refresh">@L["Refresh"]</MudButton>
    </MudStack>

    @if (top.Children.Count == 0)
    {
        <MudAlert Severity="Severity.Info">@(source == "Remote" ? L["No remote storage mounted."] : source == "Shares" ? L["No share."] : L["No mounted drive."])</MudAlert>
    }
    else
    {
    <MudPaper Elevation="0" Class="explorer desk-grow">
        <div class="ex-row ex-head">
            <div class="ex-name">@L["Name"]</div><div class="ex-mod">@L["Modified"]</div><div class="ex-size">@L["Size"]</div><div class="ex-perm">@L["Permissions"]</div>
        </div>
        <MudTreeView @key="treeKey" T="Node" Items="@TopItems()" ServerData="LoadChildren" SelectedValue="selected" SelectedValueChanged="Select"
                     ExpandOnDoubleClick="true" Hover="true" Dense="true" Class="ex-tree">
            <ItemTemplate Context="item">
                <MudTreeViewItem @bind-Expanded="@item.Expanded" Items="@item.Children" Value="@item.Value" CanExpand="@item.Expandable"
                                 Icon="@NodeIcon(item.Value!)" IconColor="@(item.Value!.IsFile ? Color.Default : Color.Info)">
                    <BodyContent>
                        @{ var node = item.Value!; var st = St(node); }
                        <div class="ex-row" @oncontextmenu="e => Context(e, node)" @oncontextmenu:preventDefault="true">
                            <div class="ex-name">@node.Name</div>
                            <div class="ex-mod">@(node.Modified is { } m ? Fmt.Dt(m) : "")</div>
                            <div class="ex-size">@(node.IsFile ? Fmt.Size(node.Size, L.Lang) : "")</div>
                            <div class="ex-perm">
                                @if (st is { Inherit: false }) { <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.LinkOff">@L["Inheritance off"]</MudChip> }
                                @if (st is { Rules.Count: > 0 }) { <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Lock">@L["{0} permission(s)", st.Rules.Count]</MudChip> }
                            </div>
                        </div>
                    </BodyContent>
                </MudTreeViewItem>
            </ItemTemplate>
        </MudTreeView>
    </MudPaper>
    }

    <MudMenu @ref="menu" PositionAtCursor="true">
        @if (menuNode is { IsFile: false })
        {
            <MudMenuItem Icon="@Icons.Material.Filled.CreateNewFolder" OnClick="() => NewFolder(menuNode)">@L["New folder"]</MudMenuItem>
        }
        @if (menuNode is { Path.Length: > 0 })
        {
            <MudMenuItem Icon="@Icons.Material.Filled.DriveFileRenameOutline" OnClick="() => Rename(menuNode)">@L["Rename"]</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.DriveFileMove" OnClick="() => MoveTo(menuNode, copy: false)">@L["Move"]</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.ContentCopy" OnClick="() => MoveTo(menuNode, copy: true)">@L["Copy"]</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="() => Delete(menuNode)">@L["Delete"]</MudMenuItem>
        }
        @if (menuNode is { IsFile: false })
        {
            @if (!NoPermissions)
            {
                <MudMenuItem Icon="@Icons.Material.Filled.Lock" OnClick="() => OpenPermissions(menuNode)">@L["Permissions"]</MudMenuItem>
                <MudDivider />
            }
            <MudMenuItem Icon="@Icons.Material.Filled.Refresh" OnClick="() => Reload(menuNode)">@L["Refresh"]</MudMenuItem>
        }
    </MudMenu>
}

<style>
    .explorer { border: 1px solid var(--mud-palette-lines-default); border-radius: 12px; overflow: auto; max-height: calc(100vh - 280px); }
    .desk-body .explorer { max-height: none; }
    .ex-row { display: grid; grid-template-columns: minmax(160px, 1fr) 170px 100px 280px; align-items: center; width: 100%; user-select: none; }
    .ex-head { padding: 6px 12px 6px 40px; font-weight: 500; position: sticky; top: 0; z-index: 1; background: var(--mud-palette-surface); border-bottom: 1px solid var(--mud-palette-lines-default); }
    .ex-tree .mud-treeview-item-content { padding-right: 12px; }
    .ex-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ex-size { text-align: right; padding-right: 16px; }
    .ex-perm { display: flex; gap: 6px; flex-wrap: wrap; }
    @@media (max-width: 800px) { .ex-row { grid-template-columns: 1fr; } .ex-mod, .ex-size, .ex-perm { display: none; } }
</style>

@code {
    /// <summary>Vrai quand la page est affichée dans une fenêtre du bureau : le titre est alors celui de la fenêtre.</summary>
    [CascadingParameter(Name = "InWindow")] bool InWindow { get; set; }

    [SupplyParameterFromQuery] public string? Share { get; set; }

    sealed class Node
    {
        public string Place = "", Path = "", Name = "";
        public DateTime? Modified;
        public int Depth;
        public bool Loaded, IsFile;
        public long Size;
        public List<Node> Children = new();
        TreeItemData<Node>? data;
        /// <summary>L'élément de l'arbre MudBlazor de ce nœud : il porte l'état ouvert/fermé et les enfants déjà lus.</summary>
        public TreeItemData<Node> Data => data ??= new() { Value = this, Text = Name, Expandable = !IsFile };
        public bool Expanded { get => Data.Expanded; set => Data.Expanded = value; }
    }

    List<string> allShares = [];
    HashSet<string> aclShares = [];
    List<BackupTarget> disks = [];
    /// <summary>Les stockages distants montés (point de montage, libellé) : leurs fichiers se parcourent comme ceux d'un disque.</summary>
    List<(string Dir, string Label)> remotes = [];
    bool IsRemote(string place) => remotes.Any(r => r.Dir == place);
    string RemoteLabel(RemoteStorage r) => r.Name + " (" + (r.Type is "onedrive" ? "OneDrive" : r.Type is "dropbox" ? "Dropbox" : r.Type.ToUpperInvariant()) + ")"
        + (r.TotalBytes > 0 ? " — " + L["{0} free of {1}", Fmt.Size(r.FreeBytes, L.Lang), Fmt.Size(r.TotalBytes, L.Lang)] : "");
    /// <summary>L'emplacement (partage ou disque monté) du nœud sélectionné.</summary>
    string? share => selected is { Place.Length: > 0 } ? selected.Place : null;
    bool IsDisk => share is not null && NasOperations.IsDisk(share);
    /// <summary>Un disque monté ou un partage ordinaire n'a pas de permissions avancées à gérer.</summary>
    bool NoPermissions => share is not null && !HasAcl(share);
    bool HasAcl(string place) => !NasOperations.IsDisk(place) && aclShares.Contains(place);
    static string Place(string location) => NasOperations.IsDisk(location) ? location : "/" + location;
    string DiskLabel(BackupTarget d) => L["Disk {0}", d.Dir] + (d.TotalBytes > 0 ? " (" + L["{0} free of {1}", Fmt.Size(d.FreeBytes, L.Lang), Fmt.Size(d.TotalBytes, L.Lang)] + ")" : "");
    Dictionary<string, Dictionary<string, FolderState>> statesBy = new();
    FolderState? St(Node n) => statesBy.GetValueOrDefault(n.Place)?.GetValueOrDefault(n.Path);
    async Task LoadStates(string place) { if (HasAcl(place)) statesBy[place] = await Repo.GetFolderStatesAsync(place); }
    string NodeIcon(Node n) => n.Depth > 0 ? Icons.Material.Filled.Folder : IsRemote(n.Place) ? Icons.Material.Filled.CloudQueue : NasOperations.IsDisk(n.Place) ? Icons.Material.Filled.Storage : Icons.Material.Filled.FolderShared;
    /// <summary>Racine invisible de l'arbre : ses enfants (premier niveau) sont les partages ou les disques montés de la source choisie.</summary>
    readonly Node top = new() { Depth = -1, Loaded = true };
    /// <summary>Change à chaque rechargement de l'arbre : MudTreeView est alors recréé à partir des éléments déjà lus.</summary>
    int treeKey;
    IReadOnlyCollection<TreeItemData<Node>> TopItems() => top.Children.Select(c => c.Data).ToList();
    string source = "Shares";
    Node? selected, menuNode;
    MudMenu? menu;
    string? error;
    bool loaded;

    bool CanFolder => selected is { IsFile: false };
    bool CanModify => selected is { Path.Length: > 0 };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var shares = await Repo.GetSharesAsync();
            allShares = shares.Select(s => s.Name).OrderBy(n => n, StringComparer.OrdinalIgnoreCase).ToList();
            aclShares = shares.Where(s => s.Acl).Select(s => s.Name).ToHashSet();
        }
        catch (Exception e) when (e is AgentException or HttpRequestException) { error = L["Agent unreachable."]; }
        try { disks = (await Agent.GetBackupTargetsAsync()).Where(t => !t.Remote).ToList(); } // les disques montés (USB…) : facultatif, la page marche sans
        catch (Exception e) when (e is AgentException or HttpRequestException) { }
        try { remotes = (await Agent.GetRemotesAsync()).Where(r => r.Mounted).Select(r => (r.MountPoint, RemoteLabel(r))).ToList(); }
        catch (Exception e) when (e is AgentException or HttpRequestException) { }
        loaded = true;
        var wanted = Share is not null && allShares.Contains(Share) ? Share : null;
        await SelectSource(allShares.Count > 0 || (disks.Count == 0 && remotes.Count == 0) ? "Shares" : disks.Count > 0 ? "Mounted drives" : "Remote", wanted);
    }

    IEnumerable<(string Place, string Label)> Places() => source switch
    {
        "Shares" => allShares.Select(s => (s, s)),
        "Mounted drives" => disks.Select(d => (d.Dir, DiskLabel(d))),
        _ => remotes.Select(r => (r.Dir, r.Label)),
    };

    /// <summary>Change de source : le premier niveau de l'arbre devient la liste de ses partages ou disques ; le premier (ou <paramref name="place"/>) est ouvert.</summary>
    async Task SelectSource(string value, string? place = null)
    {
        source = value;
        statesBy = new();
        selected = null;
        top.Children = Places().Select(p => new Node { Place = p.Place, Name = p.Label, Depth = 0 }).ToList();
        treeKey++;
        // Rien n'est lu tant qu'on n'ouvre pas un dossier (sauf celui demandé explicitement) : lister un stockage distant peut être long.
        var wanted = place is null ? null : top.Children.FirstOrDefault(c => c.Place == place);
        selected = wanted ?? top.Children.FirstOrDefault();
        if (wanted is null) return;
        await LoadStates(wanted.Place);
        await Load(wanted);
        wanted.Expanded = true;
    }

    Task Refresh() => selected is null ? Task.CompletedTask : Show(selected.Place, selected.Path);

    /// <summary>Relit l'arborescence puis sélectionne ce chemin de cet emplacement (ou le dossier existant le plus proche), en ouvrant ses parents.</summary>
    async Task Show(string place, string path)
    {
        var n = top.Children.FirstOrDefault(c => c.Place == place);
        if (n is null) return;
        await LoadStates(place);
        await Reload(n);
        foreach (var t in top.Children.Where(t => t != n && t.Loaded)) await Reload(t); // une copie vers un autre emplacement visible y apparaît
        foreach (var seg in path.Split('/', StringSplitOptions.RemoveEmptyEntries))
        {
            var child = n.Children.FirstOrDefault(c => c.Name == seg);
            if (child is null) break;
            n.Expanded = true;
            n = child;
            if (!n.IsFile) await Load(n);
        }
        selected = n;
        treeKey++;
    }

    /// <summary>Lit les sous-dossiers ; les dossiers déjà ouverts gardent leur état après un rechargement.</summary>
    async Task Load(Node n)
    {
        try
        {
            if (n.Depth == 0 && !statesBy.ContainsKey(n.Place)) await LoadStates(n.Place);
            var listing = await Agent.GetFoldersAsync(n.Place, n.Path, files: true);
            var old = n.Children.Where(c => !c.IsFile).ToDictionary(c => c.Name);
            n.Children = listing.Folders.Select(f => old.TryGetValue(f.Name, out var o) ? Touch(o, f)
                : new Node { Place = n.Place, Name = f.Name, Path = n.Path.Length == 0 ? f.Name : n.Path + "/" + f.Name, Depth = n.Depth + 1, Modified = f.ModifiedUtc }).ToList();
            n.Children.AddRange((listing.Files ?? []).Select(f => new Node { Place = n.Place, Name = f.Name, Path = n.Path.Length == 0 ? f.Name : n.Path + "/" + f.Name,
                Depth = n.Depth + 1, Modified = f.ModifiedUtc, IsFile = true, Size = f.Size, Loaded = true }));
            n.Data.Children = n.Children.Select(c => c.Data).ToList();
            n.Loaded = true;
            error = null;
        }
        catch (AgentException e) { Snack.Add(L.Translate(e.Message), Severity.Error); }
        catch (HttpRequestException) { Snack.Add(L["Agent unreachable."], Severity.Error); }
    }

    static Node Touch(Node n, FolderEntry f) { n.Modified = f.ModifiedUtc; return n; }

    async Task Reload(Node n)
    {
        await Load(n);
        foreach (var c in n.Children.Where(c => c.Expanded)) await Reload(c);
    }

    void Select(Node? n) => selected = n;

    /// <summary>Charge à l'ouverture d'un dossier (MudTreeView ServerData) ; sans parent, le premier niveau.</summary>
    async Task<IReadOnlyCollection<TreeItemData<Node>>> LoadChildren(Node? parent)
    {
        if (parent is null) return TopItems();
        if (!parent.Loaded) await Load(parent);
        return parent.Children.Select(c => c.Data).ToList();
    }

    async Task Context(MouseEventArgs e, Node n)
    {
        selected = n;
        menuNode = n;
        if (menu is not null) await menu.OpenMenuAsync(e);
    }

    static readonly DialogOptions SmallOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true, BackdropClick = false };
    static readonly DialogOptions BigOptions = new() { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true, BackdropClick = false };

    async Task NewFolder(Node? n)
    {
        if (n is null) return;
        var parameters = new DialogParameters<FolderNameDialog> { { x => x.Location, Loc(n) } };
        var dialog = await Dialogs.ShowAsync<FolderNameDialog>(L["New folder"], parameters, SmallOptions);
        if (await dialog.Result is { Canceled: false, Data: string name })
        {
            try
            {
                await Ops.CreateFolderAsync(n.Place, n.Path, name);
                Snack.Add(L["Folder created."], Severity.Success);
                await Load(n);
                n.Expanded = true;
                treeKey++;
            }
            catch (AgentException e) { Snack.Add(L.Translate(e.Message), Severity.Error); }
            catch (HttpRequestException) { Snack.Add(L["Agent unreachable."], Severity.Error); }
        }
    }

    string Loc(Node n) => Place(n.Place) + (n.Path.Length > 0 ? "/" + n.Path : "");

    static string Join(string parent, string name) => parent.Length == 0 ? name : parent + "/" + name;

    /// <summary>Exécute une opération sur un dossier, puis réaffiche l'arborescence sur <paramref name="showPath"/>.</summary>
    async Task Run(Func<Task> action, string success, string place, string showPath)
    {
        try
        {
            await action();
            Snack.Add(success, Severity.Success);
            await Show(place, showPath);
        }
        catch (AgentException e) { Snack.Add(L.Translate(e.Message), Severity.Error); }
        catch (HttpRequestException) { Snack.Add(L["Agent unreachable."], Severity.Error); }
    }

    async Task Rename(Node? n)
    {
        if (n is null || n.Path.Length == 0) return;
        var sh = n.Place;
        var parameters = new DialogParameters<FolderNameDialog>
        {
            { x => x.Message, L["Rename {0}", Loc(n)] }, { x => x.Initial, n.Name }, { x => x.ButtonText, "Rename" },
        };
        var dialog = await Dialogs.ShowAsync<FolderNameDialog>(L["Rename"], parameters, SmallOptions);
        if (await dialog.Result is { Canceled: false, Data: string name } && name != n.Name)
        {
            var parent = NasOperations.ParentOf(n.Path);
            var file = n.IsFile;
            await Run(() => Ops.MoveFolderAsync(sh, n.Path, parent, name, file), file ? L["File renamed."] : L["Folder renamed."], sh, Join(parent, name));
        }
    }

    async Task MoveTo(Node? n, bool copy)
    {
        if (n is null || n.Path.Length == 0) return;
        var sh = n.Place;
        var parameters = new DialogParameters<FolderPickerDialog>
        {
            { x => x.Share, sh }, { x => x.Exclude, n.Path }, { x => x.ExcludeLocation, sh },
            { x => x.Shares, allShares }, { x => x.Disks, disks.Select(d => (d.Dir, DiskLabel(d))).ToList() }, { x => x.Remotes, remotes },
            { x => x.Message, copy ? L["Copy {0} to:", Loc(n)] : L["Move {0} to:", Loc(n)] },
            { x => x.ButtonText, copy ? "Copy" : "Move" },
        };
        var dialog = await Dialogs.ShowAsync<FolderPickerDialog>(copy ? L["Copy"] : L["Move"], parameters, SmallOptions);
        if (await dialog.Result is not { Canceled: false, Data: FolderPick(var destLocation, var dest) }) return;
        var parent = NasOperations.ParentOf(n.Path);
        if (destLocation != sh) // autre partage ou autre disque : le nom reste, la vue reste sur la source
        {
            var f = n.IsFile;
            var p = n.Path;
            var nm = n.Name;
            await Run(() => Ops.TransferFolderAsync(sh, p, destLocation, dest, nm, f, copy),
                copy ? L["Copied to {0}.", Place(destLocation) + (dest.Length > 0 ? "/" + dest : "")] : L["Moved to {0}.", Place(destLocation) + (dest.Length > 0 ? "/" + dest : "")],
                sh, copy ? p : parent);
            return;
        }
        if (dest == parent && !copy) return; // déjà là
        var name = n.Name;
        if (dest == parent) // copier au même endroit : il faut un autre nom (« a - copie.txt » pour un fichier)
        {
            var dot = n.IsFile ? n.Name.LastIndexOf('.') : -1;
            name = dot > 0 ? L["{0} - copy", n.Name[..dot]] + n.Name[dot..] : L["{0} - copy", n.Name];
        }
        var path = n.Path;
        var file = n.IsFile;
        await Run(() => copy ? Ops.CopyFolderAsync(sh, path, dest, name, file) : Ops.MoveFolderAsync(sh, path, dest, name, file),
            copy ? (file ? L["File copied."] : L["Folder copied."]) : (file ? L["File moved."] : L["Folder moved."]), sh, Join(dest, name));
    }

    async Task Delete(Node? n)
    {
        if (n is null || n.Path.Length == 0) return;
        var sh = n.Place;
        var path = n.Path;
        if (n.IsFile)
        {
            var ok = await Dialogs.ShowMessageBoxAsync(L["Delete {0}", n.Name], L["File {0} will be deleted. This cannot be undone.", Loc(n)],
                yesText: L["Delete"], cancelText: L["Cancel"]);
            if (ok != true) return;
            await Run(() => Ops.DeleteFolderAsync(sh, path, true), L["File deleted."], sh, NasOperations.ParentOf(path));
            return;
        }
        var parameters = new DialogParameters<ConfirmNameDialog>
        {
            { x => x.Expected, n.Name },
            { x => x.Message, L["Folder {0} and everything it contains will be deleted. This cannot be undone.", Loc(n)] },
            { x => x.ButtonText, "Delete" },
            { x => x.Action, () => Ops.DeleteFolderAsync(sh, path) },
        };
        var dialog = await Dialogs.ShowAsync<ConfirmNameDialog>(L["Delete {0}", n.Name], parameters, SmallOptions);
        if (await dialog.Result is { Canceled: false })
        {
            Snack.Add(L["Folder deleted."], Severity.Success);
            await Show(sh, NasOperations.ParentOf(path));
        }
    }

    async Task OpenPermissions(Node? n)
    {
        if (n is null) return;
        var parameters = new DialogParameters<FolderPermissionsDialog> { { x => x.Share, n.Place }, { x => x.Path, n.Path } };
        var title = L["Permissions of {0}", "/" + n.Place + (n.Path.Length > 0 ? "/" + n.Path : "")];
        await (await Dialogs.ShowAsync<FolderPermissionsDialog>(title, parameters, BigOptions)).Result;
        await LoadStates(n.Place);
    }
}
