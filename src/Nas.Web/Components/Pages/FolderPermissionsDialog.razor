@* Permissions d'un dossier du gestionnaire de fichiers, dans leur dialogue. *@
<MudDialog>
    <DialogContent>
        <FolderPermissions Share="@Share" Path="@Path" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Close(DialogResult.Ok(true))">@L["Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter, EditorRequired] public string Share { get; set; } = "";
    [Parameter, EditorRequired] public string Path { get; set; } = "";
}
