@inject AgentClient Agent
@inject DockerOperations Ops
@inject NasFolderPicker Picker
@inject IJSRuntime JS
@implements IAsyncDisposable

@* Création ou modification d'une stack Compose. Le fichier est validé par « docker compose config » avant d'être enregistré. *@
<MudDialog>
    <DialogContent>
        @if (error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3" Style="white-space:pre-wrap">@error</MudAlert>
        }
        <MudTextField @bind-Value="name" Label="@L["Stack name"]" Immediate="true" Disabled="@(busy || Existing is not null)"
                      HelperText="@L["Lowercase letters, digits, _ and -."]" AutoFocus="@(Existing is null)" />
        <MudTextField @bind-Value="content" Label="compose.yml" Lines="18" Immediate="true" DebounceInterval="600" OnDebounceIntervalElapsed="Validate" Disabled="busy" Class="mt-3 compose-text"
                      UserAttributes='@(new Dictionary<string, object> { ["id"] = "stack-text", ["spellcheck"] = "false" })' />
        @* Un seul bandeau : seuls sa severite et son texte changent (le resultat precedent reste, attenue, pendant une nouvelle validation). *@
        <MudAlert Severity="@CheckSeverity" Dense="true" Class="@("mt-2 compose-check" + (checking ? " checking" : ""))" Style="white-space:pre-wrap">@CheckText</MudAlert>
        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.CreateNewFolder" OnClick="InsertFolder" Disabled="busy" Class="mt-2">@L["Insert a NAS folder path"]</MudButton>
        <MudText Typo="Typo.caption" Class="d-block mt-1">@L["Tab indents and Shift+Tab outdents (2 spaces). Press Esc then Tab to leave the editor with the keyboard."]</MudText>
        <MudText Typo="Typo.caption" Class="d-block mt-1">@L["The path is inserted where the cursor is. Docker gives containers full access to it, whatever the share permissions."]</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()" Disabled="busy">@L["Cancel"]</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="() => Save(false)" Disabled="@(busy || !CanSave)">@L["Save"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => Save(true)" Disabled="@(busy || !CanSave)">@(busy ? L["In progress…"] : L["Save and start"])</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .compose-text textarea { font-family: ui-monospace, Consolas, monospace; font-size: 13px; }
    .compose-check { transition: opacity .15s; }
    .compose-check.checking { opacity: .55; }
</style>

@code {
    [CascadingParameter] IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public string? Existing { get; set; }

    const string Template = "services:\n  app:\n    image: nginx:latest\n    ports:\n      - \"8080:80\"\n    restart: unless-stopped\n";

    string name = "", content = Template;
    string? error;
    bool busy, checking;
    StackValidation? check;
    int checkId; // seule la dernière validation compte : une réponse tardive ne remplace pas la plus récente

    /// <summary>Enregistrer est impossible tant que le dernier résultat est une erreur. Les boutons ne clignotent pas pendant une validation : le serveur revalide à l'enregistrement.</summary>
    bool CanSave => check is not { Error: not null };

    Severity CheckSeverity => check switch
    {
        null => Severity.Info,
        { Error: not null } => Severity.Error,
        { Checked: false } => Severity.Info,
        { MissingImages.Count: > 0 } => Severity.Warning,
        _ => Severity.Success,
    };

    string CheckText => check switch
    {
        null => L["Checking the file…"],
        { Error: not null } => L["The compose file is invalid: {0}", check.Error],
        { Checked: false } => L["The file is not checked: Docker or Compose is not available."],
        { MissingImages.Count: > 0 } => L["The compose file is valid."] + " " + L["Not on this NAS yet, downloaded when the stack starts (it fails if the name is wrong):"] + " " + string.Join(", ", check.MissingImages),
        _ => L["The compose file is valid."],
    };

    IJSObjectReference? module;

    /// <summary>Aide à la saisie YAML (retrait conservé, Tab, listes) : le script se branche sur la zone de texte une fois affichée.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./yaml-editor.js");
            await module.InvokeVoidAsync("attach", "stack-text");
        }
        catch (JSException) { } // sans le script, la zone de texte reste un champ ordinaire
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        if (module is null) return;
        try { await module.InvokeVoidAsync("detach", "stack-text"); await module.DisposeAsync(); }
        catch (Exception e) when (e is JSDisconnectedException or JSException) { }
    }

    protected override async Task OnInitializedAsync()
    {
        if (Existing is null) { await Validate(); return; }
        name = Existing;
        try { content = (await Agent.GetStackAsync(Existing)).Content; }
        catch (AgentException e) { error = L.Translate(e.Message); }
        catch (HttpRequestException) { error = L["Agent unreachable."]; }
        await Validate();
    }

    async Task Validate()
    {
        var id = ++checkId;
        checking = true;
        StackValidation? result = null;
        try { result = await Agent.ValidateStackAsync(Existing, content); }
        catch (AgentException e) { result = new(true, L.Translate(e.Message), []); }
        catch (HttpRequestException) { } // agent injoignable : on ne bloque pas, l'enregistrement le signalera
        if (id != checkId) return;
        check = result;
        checking = false;
    }

    async Task InsertFolder()
    {
        try
        {
            if (await Picker.PickAsync() is { } path)
                content = await JS.InvokeAsync<string?>("ursanasInsertAtCursor", "stack-text", path) ?? content + path;
            await Validate();
        }
        catch (AgentException e) { error = L.Translate(e.Message); }
        catch (HttpRequestException) { error = L["Agent unreachable."]; }
    }

    async Task Save(bool start)
    {
        error = null;
        busy = true;
        try
        {
            await Ops.SaveStackAsync(name.Trim(), content);
            if (start) await Ops.StackAsync(name.Trim(), "up");
            Dialog.Close(DialogResult.Ok(start));
            return;
        }
        catch (AgentException e) { error = L.Translate(e.Message); }
        catch (HttpRequestException) { error = L["Agent unreachable."]; }
        busy = false;
    }
}
