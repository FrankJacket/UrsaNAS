@page "/journal"
@inherits AutoRefreshBase
@inject Repo Repo
@inject AuthenticationStateProvider Auth
@inject IDialogService Dialogs
@inject ISnackbar Snack
@inject IJSRuntime JS

@if (!InWindow) { <MudText Typo="Typo.h4" Class="mb-4">@L["Audit log"]</MudText> }

<MudStack Row="true" Spacing="2" Class="mb-2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" OnClick="Download" Disabled="@(busy || rows.Count == 0)">@L["Download CSV"]</MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteSweep" OnClick="Clear" Disabled="@(busy || rows.Count == 0)">@L["Clear the log"]</MudButton>
    <MudText Typo="Typo.caption">@L["The table shows the latest {0} entries; the download holds every entry.", Shown]</MudText>
</MudStack>

<MudTable Items="rows" Hover="true" Dense="true" FixedHeader Virtualize Class="desk-grow" Height="@(InWindow ? null : "calc(100vh - 190px)")">
    <HeaderContent><MudTh>@L["Date"]</MudTh><MudTh>@L["Author"]</MudTh><MudTh>@L["Action"]</MudTh><MudTh>@L["Detail"]</MudTh></HeaderContent>
    <RowTemplate>
        <MudTd>@Fmt.Dt(context.At)</MudTd>
        <MudTd>@L.Translate(context.Actor)</MudTd>
        <MudTd>@L.Translate(context.Action)</MudTd>
        <MudTd>@L.Translate(context.Detail)</MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText Class="pa-4">@L["No entries."]</MudText></NoRecordsContent>
</MudTable>

@code {
    /// <summary>Vrai quand la page est affichée dans une fenêtre du bureau : le titre est alors celui de la fenêtre.</summary>
    [CascadingParameter(Name = "InWindow")] bool InWindow { get; set; }

    const int Shown = 200;

    List<AuditRow> rows = new();
    bool busy;

    protected override async Task LoadAsync() => rows = await Repo.GetAuditAsync(Shown);

    async Task<string> ActorAsync() => (await Auth.GetAuthenticationStateAsync()).User.Identity?.Name ?? "unknown";

    async Task Download()
    {
        busy = true;
        try
        {
            var filename = $"ursanas-audit-{DateTime.Now:yyyyMMdd-HHmm}.csv";
            var err = await JS.InvokeAsync<string?>("ursanasDownloadPost", "/downloads/audit-csv", "{}", filename);
            if (err is not null) Snack.Add(L.Translate(err), Severity.Error);
            else await LoadAsync(); // le téléchargement est lui-même journalisé
        }
        finally { busy = false; }
    }

    async Task Clear()
    {
        var ok = await Dialogs.ShowMessageBoxAsync(L["Clear the audit log?"],
            L["Every entry is deleted for good. Download the log first if you want to keep a copy. This action is recorded in the log afterwards."],
            yesText: L["Clear the log"], cancelText: L["Cancel"]);
        if (ok != true) return;
        busy = true;
        try
        {
            var count = await Repo.ClearAuditAsync();
            await Repo.AuditAsync(await ActorAsync(), "Audit log cleared", Msg.F("{0} entries deleted", count));
            Snack.Add(L["Audit log cleared."], Severity.Success);
            await LoadAsync();
        }
        finally { busy = false; }
    }
}
