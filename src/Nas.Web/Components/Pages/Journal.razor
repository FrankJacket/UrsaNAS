@page "/journal"
@inherits AutoRefreshBase
@inject Repo Repo

<MudText Typo="Typo.h4" Class="mb-4">@L["Journal"]</MudText>
<MudTable Items="rows" Hover="true" Dense="true">
    <HeaderContent><MudTh>@L["Date"]</MudTh><MudTh>@L["Author"]</MudTh><MudTh>@L["Action"]</MudTh><MudTh>@L["Detail"]</MudTh></HeaderContent>
    <RowTemplate>
        <MudTd>@Fmt.Dt(context.At)</MudTd>
        <MudTd>@L.Translate(context.Actor)</MudTd>
        <MudTd>@L.Translate(context.Action)</MudTd>
        <MudTd>@L.Translate(context.Detail)</MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText Class="pa-4">@L["No entries."]</MudText></NoRecordsContent>
</MudTable>

@code {
    List<AuditRow> rows = new();
    protected override async Task LoadAsync() => rows = await Repo.GetAuditAsync();
}
