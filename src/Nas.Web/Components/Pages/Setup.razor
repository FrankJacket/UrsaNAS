@page "/setup"
@layout EmptyLayout
@attribute [AllowAnonymous]
@inject AdminAccounts Accounts
@inject SetupToken Token
@inject LoginThrottle Throttle
@inject Repo Repo
@inject NavigationManager Nav

<PageTitle>Installation — UrsaNAS</PageTitle>
<h1>Installation</h1>
<p class="hint">Crée le premier administrateur. Le jeton d'installation est dans le journal du service
    (<code>journalctl -u ursanas-web</code>) et dans le fichier <code>setup-token.txt</code> du dossier de données.</p>

<EditForm Model="form" FormName="setup" OnValidSubmit="Submit" method="post">
    <label for="token">Jeton d'installation</label>
    <InputText id="token" @bind-Value="form.Token" autocomplete="off" />
    <label for="name">Identifiant de l'administrateur</label>
    <InputText id="name" @bind-Value="form.Name" autocomplete="username" />
    <label for="password">Mot de passe</label>
    <InputText id="password" type="password" @bind-Value="form.Password" autocomplete="new-password" />
    <label for="confirm">Confirmer le mot de passe</label>
    <InputText id="confirm" type="password" @bind-Value="form.Confirm" autocomplete="new-password" />
    @if (error is not null)
    {
        <div class="error">@error</div>
    }
    <button type="submit">Créer l'administrateur</button>
</EditForm>

@code {
    [CascadingParameter] HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] SetupForm form { get; set; } = default!;
    string? error;

    sealed class SetupForm
    {
        public string Token { get; set; } = "";
        public string Name { get; set; } = "";
        public string Password { get; set; } = "";
        public string Confirm { get; set; } = "";
    }

    protected override async Task OnInitializedAsync()
    {
        form ??= new();
        if (await Accounts.CountAsync() > 0) Nav.NavigateTo("/login", forceLoad: true);
    }

    async Task Submit()
    {
        var ip = HttpContext.Connection.RemoteIpAddress?.ToString() ?? "?";
        if (await Accounts.CountAsync() > 0) { Nav.NavigateTo("/login", forceLoad: true); return; }
        if (Throttle.IsLocked("setup", ip)) { error = "Trop d'essais échoués. Réessaie dans quelques minutes."; return; }
        if (!Token.Verify(form.Token))
        {
            Throttle.Fail("setup", ip);
            error = "Jeton d'installation incorrect.";
            return;
        }
        if (form.Password != form.Confirm) { error = "Les deux mots de passe ne correspondent pas."; return; }

        try { await Accounts.CreateAsync(form.Name, form.Password); }
        catch (AgentException e) { error = e.Message; return; }

        Token.Clear();
        var admin = (await Accounts.ValidateAsync(form.Name, form.Password))!;
        await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, AdminAccounts.PrincipalFor(admin));
        await Repo.AuditAsync(admin.Name, "Premier administrateur créé", ip);
        Nav.NavigateTo("/", forceLoad: true);
    }
}
