@inject BackupOperations Ops
@inject AgentClient Agent
@inject Repo Repo
@inject IDialogService Dialogs

@* Création ou modification d'un travail de sauvegarde. *@
<MudDialog>
    <DialogContent>
        @if (error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@error</MudAlert>
        }
        <MudTextField @bind-Value="job.Name" Label="@L["Job name"]" Immediate="true" Disabled="busy" AutoFocus="@(job.Id == 0)" Class="mb-3" />

        <MudTabs Elevation="0" Rounded="true" TabPanelsClass="pt-3">
            <MudTabPanel Text="@L["What to back up"]">
                <div class="mt-2">
                    @foreach (var item in selection)
                    {
                        var entry = item;
                        <MudChip T="string" Size="Size.Small" OnClose="() => selection.Remove(entry)">/@Label(entry)</MudChip>
                    }
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FactCheck" OnClick="Choose" Disabled="busy">@L["Choose what to back up"]</MudButton>
                </div>
                <MudText Typo="Typo.caption" Class="d-block">@L["Pick shares, folders and files across all the shares."]</MudText>
                @if (Existing is { SubFolders: false } && SharesOf().Count > 1)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">@L["With several shares, each one is copied into its own sub-folder of the folder on the disk. What was already copied stays where it is; delete it by hand if you do not need it."]</MudAlert>
                }
                <MudSwitch T="bool" @bind-Value="job.Snapshot" Label="@L["Copy from a ZFS snapshot"]" Color="Color.Primary" Disabled="@(busy || !HasDataset)" Class="mt-2" />
                <MudText Typo="Typo.caption" Class="d-block">@(HasDataset
                    ? L["A snapshot freezes the share during the copy, so files that change (databases, virtual disks) are copied consistently."]
                    : L["Only available for a share stored on a ZFS dataset. Without a snapshot, files that change during the copy may be copied in an inconsistent state."])</MudText>

                <MudSwitch T="bool" @bind-Value="job.Verify" Label="@L["Verify each copied file (slower)"]" Color="Color.Primary" Disabled="busy" />
                <MudTextField @bind-Value="excludes" Label="@L["Files and folders to skip"]" Lines="4" Disabled="busy"
                              HelperText="@L["One per line. * and ? are allowed. A name without a slash matches at any depth."]" />
            </MudTabPanel>
            <MudTabPanel Text="@L["Where to copy"]">
                <MudSelect T="string" @bind-Value="job.TargetDir" Label="@L["Backup disk"]" Disabled="busy"
                           HelperText="@(targets.Count == 0 ? L["No disk mounted under /mnt or /media. Plug the disk and mount it, then reopen this window."] : L["The disk must be mounted on the NAS first."])">
                    @foreach (var t in TargetChoices())
                    {
                        <MudSelectItem T="string" Value="@t.Dir">@Describe(t)</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField @bind-Value="job.DestFolder" Label="@L["Folder on the disk"]" Disabled="busy" HelperText="@L["Several jobs can share one disk, each in its own folder."]" />
                <MudSwitch T="bool" @bind-Value="job.WindowsDisk" Label="@L["The disk is formatted NTFS or exFAT"]" Color="Color.Primary" Disabled="busy" />

            </MudTabPanel>
            <MudTabPanel Text="@L["Schedule"]">
                
                               
                <MudSelect T="int" @bind-Value="job.ScheduleMode" Label="@L["Schedule"]" Disabled="busy">
                    <MudSelectItem T="int" Value="@BackupSchedule.Manual">@L["Manual only"]</MudSelectItem>
                    <MudSelectItem T="int" Value="@BackupSchedule.Daily">@L["Every day"]</MudSelectItem>
                    <MudSelectItem T="int" Value="@BackupSchedule.OnPlug">@L["Whenever the disk is connected"]</MudSelectItem>
                </MudSelect>
                @if (job.ScheduleMode == BackupSchedule.Daily)
                {
                    <MudTimePicker Time="@TimeSpan.Parse(job.DailyTime)" TimeChanged="OnDailyTimeChanged"
                                   Label="@L["Time"]" Disabled="busy" Style="max-width:280px"
                                   TimeFormat="@Culture.DateTimeFormat.ShortTimePattern" AmPm="@Culture.DateTimeFormat.ShortTimePattern.Contains("tt")" />
                }
                <MudSwitch T="bool" @bind-Value="job.Enabled" Label="@L["Enabled"]" Color="Color.Primary" Disabled="busy" Class="mt-2" />
            </MudTabPanel>

            <MudTabPanel Text="@L["Retention"]">
                <MudSwitch T="bool" @bind-Value="job.MirrorDeletes" Label="@L["Remove from the copy what was deleted from the share"]" Color="Color.Primary" Disabled="busy" />
                <MudNumericField T="int" @bind-Value="job.RetentionDays" Label="@L["Keep deleted and replaced files (days)"]" Min="0" Max="@BackupRules.MaxRetentionDays" HideSpinButtons="true" Disabled="busy"
                                 HelperText="@L["They go to a trash folder on the disk. 0 = delete right away."]" />
                
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()" Disabled="busy">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="busy">@L["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public BackupJobRow? Existing { get; set; }

    BackupJobRow job = new();
    List<ShareDef> shares = new();
    IReadOnlyList<BackupTarget> targets = [];
    string excludes = "";
    string? error;
    bool busy;

    System.Globalization.CultureInfo Culture => System.Globalization.CultureInfo.GetCultureInfo(L.Lang);

    void OnDailyTimeChanged(TimeSpan? v) { if (v is { } t) job.DailyTime = t.ToString(@"hh\:mm"); }

    bool HasDataset => SharesOf().Any(s => shares.FirstOrDefault(x => x.Name == s)?.Dataset is not null);
    List<(string Share, string Path)> selection = new();
    List<string> SharesOf() => selection.Select(s => s.Share).Distinct(StringComparer.Ordinal).ToList();
    static string Label((string Share, string Path) s) => s.Path.Length == 0 ? s.Share : s.Share + "/" + s.Path;

    protected override async Task OnInitializedAsync()
    {
        shares = await Repo.GetSharesAsync();
        try { targets = await Agent.GetBackupTargetsAsync(); }
        catch (AgentException e) { error = L.Translate(e.Message); }
        catch (HttpRequestException) { error = L["Agent unreachable."]; }

        if (Existing is not null)
        {
            job = new BackupJobRow
            {
                Id = Existing.Id, Name = Existing.Name, Share = Existing.Share, TargetDir = Existing.TargetDir, TargetId = Existing.TargetId,
                DestFolder = Existing.DestFolder, Enabled = Existing.Enabled, ScheduleMode = Existing.ScheduleMode, DailyTime = Existing.DailyTime,
                MirrorDeletes = Existing.MirrorDeletes, RetentionDays = Existing.RetentionDays, Verify = Existing.Verify,
                WindowsDisk = Existing.WindowsDisk, Snapshot = Existing.Snapshot, CreatedUtc = Existing.CreatedUtc,
            };
            selection = Existing.Selection();
            excludes = Existing.Excludes;
        }
        else
        {
            job.TargetDir = targets.FirstOrDefault()?.Dir ?? "";
            excludes = job.Excludes;
        }
    }

    /// <summary>Les disques montés, plus celui déjà enregistré dans le travail s'il n'est plus monté.</summary>
    IEnumerable<BackupTarget> TargetChoices() =>
        job.TargetDir.Length > 0 && targets.All(t => t.Dir != job.TargetDir)
            ? targets.Prepend(new BackupTarget(job.TargetDir, null, null, 0, 0, null))
            : targets;

    string Describe(BackupTarget t)
    {
        var parts = new List<string> { t.Dir };
        if (t.Device is not null) parts.Add(t.Device);
        if (t.FileSystem is not null) parts.Add(t.FileSystem);
        if (t.TotalBytes > 0) parts.Add(L["{0} free of {1}", Fmt.Size(t.FreeBytes, L.Lang), Fmt.Size(t.TotalBytes, L.Lang)]);
        else parts.Add(L["not mounted"]);
        return string.Join(" — ", parts);
    }

    async Task Choose()
    {
        var parameters = new DialogParameters<BackupSelectDialog> { { x => x.Selected, selection.Select(Label).ToList() } };
        var dialog = await Dialogs.ShowAsync<BackupSelectDialog>(L["Choose what to back up"], parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
        if (await dialog.Result is { Canceled: false, Data: List<string> chosen })
        {
            selection = chosen.Select(p => { var i = p.IndexOf('/'); return i < 0 ? (p, "") : (p[..i], p[(i + 1)..]); }).ToList();
            if (!HasDataset) job.Snapshot = false;
        }
    }

    async Task Save()
    {
        error = null;
        busy = true;
        try
        {
            if (!HasDataset) job.Snapshot = false;
            job.SetSelection(selection, keepLegacy: Existing is { SubFolders: false });
            job.Excludes = excludes;
            await Ops.SaveJobAsync(job);
            Dialog.Close(DialogResult.Ok(job.Name));
            return;
        }
        catch (AgentException e) { error = L.Translate(e.Message); }
        catch (HttpRequestException) { error = L["Agent unreachable."]; }
        busy = false;
    }
}
