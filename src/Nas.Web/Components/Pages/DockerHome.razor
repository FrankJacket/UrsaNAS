@page "/docker"
@inherits AutoRefreshBase
@inject AgentClient Agent
@inject DockerOperations Ops
@inject IDialogService Dialogs
@inject ISnackbar Snack

@if (!InWindow)
{
    <MudText Typo="Typo.h4" Class="mb-4">Docker</MudText>
}

@if (!loaded)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@error</MudAlert>
}
else if (status is { State: DockerState.Ready })
{
    <MudAlert Severity="Severity.Success" Class="mb-4">
        @L["Docker is running."] @L["Engine {0}", status.Version ?? "?"]@(status.ComposeVersion is null ? "" : " · Compose " + status.ComposeVersion)
    </MudAlert>
    <MudStack Row="true" Wrap="Wrap.Wrap" Class="mb-4">
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="Restart" Disabled="busy">@L["Restart the service"]</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.StopCircle" OnClick="Stop" Disabled="busy">@L["Stop the service"]</MudButton>
    </MudStack>
    @if (status.ComposeVersion is null)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            @L["Docker Compose is not installed, so stacks are unavailable. Install it with:"] <code>sudo apt install docker-compose</code>
        </MudAlert>
    }
    <MudStack Row="true" Wrap="Wrap.Wrap" Class="mb-6">
        <MudButton Href="@(DockNav is null ? "/docker/containers" : null)" OnClick="@(() => DockNav?.Go("containers"))" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Inventory2">@L["Containers"]</MudButton>
        <MudButton Href="@(DockNav is null ? "/docker/images" : null)" OnClick="@(() => DockNav?.Go("images"))" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Album">@L["Images"]</MudButton>
        <MudButton Href="@(DockNav is null ? "/docker/stacks" : null)" OnClick="@(() => DockNav?.Go("stacks"))" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Layers">@L["Stacks"]</MudButton>
        <MudButton Href="@(DockNav is null ? "/docker/volumes" : null)" OnClick="@(() => DockNav?.Go("volumes"))" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Lan">@L["Volumes and networks"]</MudButton>
    </MudStack>
    <MudAlert Severity="Severity.Info">
        @L["A container that mounts a folder of the NAS reads and writes it with full rights: the permissions (ACLs) of the shares do not apply to Docker."]
    </MudAlert>
}
else if (status is { State: DockerState.Stopped })
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">@L["Docker is installed but its service is not running."]</MudAlert>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="Start" Disabled="busy" Class="mb-4">@L["Start the service"]</MudButton>
    <MudText>@L["This page checks again every few seconds: the Docker menu appears as soon as the service answers."]</MudText>
}
else
{
    <MudAlert Severity="Severity.Info" Class="mb-4">@L["Docker is not installed on this NAS, so the Docker menu is hidden."]</MudAlert>
    <MudText Class="mb-2">@L["To install it, run on the NAS:"]</MudText>
    <MudPaper Class="pa-4 mb-4"><code>sudo apt install docker.io docker-compose</code></MudPaper>
    <MudText>@L["This page checks again every few seconds: the Docker menu appears as soon as Docker is ready."]</MudText>
}

@code {
    /// <summary>Navigation interne de la fenêtre Docker ; absente quand la page est ouverte seule.</summary>
    [CascadingParameter] DockerNav? DockNav { get; set; }

    /// <summary>Vrai quand la page est affichée dans une fenêtre du bureau : le titre est alors celui de la fenêtre.</summary>
    [CascadingParameter(Name = "InWindow")] bool InWindow { get; set; }

    DockerStatus? status;
    string? error;
    bool loaded, busy;

    async Task Run(string action, string success)
    {
        busy = true;
        try { await Ops.ServiceAsync(action); Snack.Add(success, Severity.Success); }
        catch (AgentException e) { Snack.Add(L.Translate(e.Message), Severity.Error); }
        catch (HttpRequestException) { Snack.Add(L["Agent unreachable."], Severity.Error); }
        busy = false;
        await LoadAsync();
    }

    Task Start() => Run("start", L["Docker service started."]);
    Task Restart() => Run("restart", L["Docker service restarted."]);

    async Task Stop()
    {
        var ok = await Dialogs.ShowMessageBoxAsync(L["Stop the Docker service?"],
            L["The containers that are running stop with it, and every Docker page stays unavailable until the service is started again."],
            yesText: L["Stop the service"], cancelText: L["Cancel"]);
        if (ok == true) await Run("stop", L["Docker service stopped."]);
    }

    protected override TimeSpan Interval => TimeSpan.FromSeconds(5);

    protected override async Task LoadAsync()
    {
        try { status = await Agent.GetDockerStatusAsync(); error = null; }
        catch (AgentException e) { error = L.Translate(e.Message); }
        catch (HttpRequestException) { error = L["Agent unreachable: is the ursanas-agent service running?"]; }
        loaded = true;
    }
}
