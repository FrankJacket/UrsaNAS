@inject DiskOperations Ops

<MudDialog>
    <DialogContent>
        @if (error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@error</MudAlert>
        }
        <MudTextField @bind-Value="name" Label="@L["Folder name"]" Immediate="true" Disabled="busy" AutoFocus="true" HelperText="@L["The disk will appear under /mnt/{0}", name]" />
        <MudCheckBox T="bool" @bind-Value="persistent" Label="@L["Mount at every start"]" Disabled="busy" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()" Disabled="busy">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="@(busy || name.Trim().Length == 0)">@(busy ? L["In progress…"] : L["Mount"])</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter, EditorRequired] public string Partition { get; set; } = "";
    [Parameter] public string? Suggestion { get; set; }

    string name = "";
    bool persistent = true;
    string? error;
    bool busy;

    protected override void OnInitialized() => name = Suggestion ?? "";

    async Task Save()
    {
        error = null;
        busy = true;
        try
        {
            await Ops.MountAsync(new MountPartitionRequest(Partition, name.Trim(), persistent));
            Dialog.Close(DialogResult.Ok(true));
            return;
        }
        catch (AgentException e) { error = L.Translate(e.Message); }
        catch (HttpRequestException) { error = L["Agent unreachable."]; }
        busy = false;
    }
}
