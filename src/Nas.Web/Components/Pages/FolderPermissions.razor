@inject Repo Repo
@inject AgentClient Agent
@inject NasOperations Ops
@inject IDialogService Dialogs
@inject ISnackbar Snack

@* Contenu des permissions d'un dossier (dans FolderPermissionsDialog et dans l'onglet Permissions d'un partage) :
   règles propres, héritage (rupture avec ou sans copie), aperçu des droits d'un utilisateur. *@
@if (error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@error</MudAlert>
}

@if (Path.Length > 0)
{
    @if (Inherit)
    {
        <MudAlert Severity="Severity.Normal" Dense="true" Class="mb-3"
                  ContentAlignment="HorizontalAlignment.Left">
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <span>@L["This folder inherits the permissions of its parent folder."]</span>
                <MudSpacer />
                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.LinkOff" OnClick="BreakInheritance" Disabled="busy">@L["Break inheritance…"]</MudButton>
            </MudStack>
        </MudAlert>
    }
    else
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <span>@L["Inheritance is off: only the permissions below apply here."]</span>
                <MudSpacer />
                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Link" OnClick="RestoreInheritance" Disabled="busy">@L["Restore inheritance"]</MudButton>
            </MudStack>
        </MudAlert>
    }
}

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
    <MudText Typo="Typo.subtitle1">@L["Permissions on this folder"]</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="() => EditRule(null)" Disabled="busy">@L["Add a permission"]</MudButton>
</MudStack>
<MudTable Items="own" Hover="true" Dense="true" Loading="@busy">
    <HeaderContent><MudTh>@L["Who"]</MudTh><MudTh>@L["Type"]</MudTh><MudTh>@L["Rights"]</MudTh><MudTh>@L["Apply to"]</MudTh><MudTh></MudTh></HeaderContent>
    <RowTemplate>
        <MudTd>@Subject(context)</MudTd>
        <MudTd><MudChip T="string" Size="Size.Small" Color="@(context.Allow ? Color.Success : Color.Error)">@(context.Allow ? L["Allow"] : L["Deny"])</MudChip></MudTd>
        <MudTd>@AclText.Rights(context.Rights, L)</MudTd>
        <MudTd>@AclText.Apply(context.Apply, context.FirstLevelOnly, L)</MudTd>
        <MudTd Style="text-align:right;white-space:nowrap">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => EditRule(context)" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteRule(context)" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText Class="pa-4">@L["No permission set directly on this folder."]</MudText></NoRecordsContent>
</MudTable>

@if (inherited.Count > 0)
{
    <MudText Typo="Typo.subtitle1" Class="mt-4 mb-1">@L["Inherited from parent folders"]</MudText>
    <MudSimpleTable Dense="true" Elevation="0">
        <tbody>
            @foreach (var (from, r) in inherited)
            {
                <tr>
                    <td>@Subject(r)</td>
                    <td>@(r.Allow ? L["Allow"] : L["Deny"])</td>
                    <td>@AclText.Rights(r.Rights, L)</td>
                    <td>@AclText.Apply(r.Apply, r.FirstLevelOnly, L)</td>
                    <td><code>/@(from.Length == 0 ? Share : $"{Share}/{from}")</code></td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
}

<MudText Typo="Typo.subtitle1" Class="mt-4 mb-1">@L["What can a user do here?"]</MudText>
<MudSelect T="string" @bind-Value="previewUser" Label="@L["User"]" Dense="true" Style="max-width:320px" Clearable="true">
    @foreach (var u in users)
    {
        <MudSelectItem T="string" Value="@u">@u</MudSelectItem>
    }
</MudSelect>
@if (!string.IsNullOrEmpty(previewUser))
{
    <MudText Typo="Typo.body2" Class="mt-1"><b>@L["In this folder"]</b> : @AclText.Rights(Effective(false), L)</MudText>
    <MudText Typo="Typo.body2"><b>@L["Files directly inside"]</b> : @AclText.Rights(Effective(true), L)</MudText>
}

@code {
    [Parameter, EditorRequired] public string Share { get; set; } = "";
    [Parameter, EditorRequired] public string Path { get; set; } = "";

    IReadOnlyList<string> users = [];
    IReadOnlyList<NasGroup> groups = [];
    Dictionary<string, FolderState> states = new();
    string? error, previewUser;
    bool busy;

    bool Inherit => states.GetValueOrDefault(Path)?.Inherit ?? true;
    List<AclRule> own => (states.GetValueOrDefault(Path)?.Rules ?? []).ToList();
    IReadOnlyList<(string From, AclRule Rule)> inherited => AclInheritance.InheritedHere(Path, states);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            states = await Repo.GetFolderStatesAsync(Share);
            users = (await Agent.GetUsersAsync()).Select(u => u.Name).ToList();
            groups = await Agent.GetGroupsAsync();
        }
        catch (AgentException e) { error = L.Translate(e.Message); }
        catch (HttpRequestException) { error = L["Agent unreachable."]; }
    }

    RenderFragment Subject(AclRule r) => @<span><MudIcon Icon="@(r.Kind == AclSubjectKind.User ? Icons.Material.Filled.Person : Icons.Material.Filled.Group)" Size="Size.Small" Class="mr-1" />@r.Name</span>;

    AclRights Effective(bool file)
    {
        var memberOf = groups.Where(g => g.Members.Contains(previewUser!)).Select(g => g.Name).ToHashSet();
        return AclEvaluator.Effective(AclInheritance.FullChain(Path, states), previewUser!, memberOf, file);
    }

    static readonly DialogOptions RuleOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true, BackdropClick = false };

    async Task EditRule(AclRule? existing)
    {
        var parameters = new DialogParameters<AclRuleDialog>
        {
            { x => x.Existing, existing }, { x => x.Users, users }, { x => x.Groups, groups.Select(g => g.Name).Where(n => n != AclRules.AdminsGroup).ToList() },
        };
        var dialog = await Dialogs.ShowAsync<AclRuleDialog>(existing is null ? L["Add a permission"] : L["Edit a permission"], parameters, RuleOptions);
        if (await dialog.Result is { Canceled: false, Data: List<AclRule> added })
        {
            var list = own;
            if (existing is not null)
            {
                var at = list.IndexOf(existing);
                list.RemoveAt(at);
                list.InsertRange(at, added);
            }
            else list.AddRange(added);
            await Run(() => Ops.SaveFolderAclAsync(Share, Path, list), L["Permissions saved."]);
        }
    }

    async Task DeleteRule(AclRule r)
    {
        var list = own;
        list.Remove(r);
        await Run(() => Ops.SaveFolderAclAsync(Share, Path, list), L["Permissions saved."]);
    }

    /// <summary>Oui = copier les permissions héritées, Non = les retirer, Annuler = ne rien changer.</summary>
    async Task BreakInheritance()
    {
        var choice = await Dialogs.ShowMessageBoxAsync(L["Break inheritance?"],
            L["This folder will stop receiving permissions from its parent folders. Copy them here to keep today's access, or remove them."],
            yesText: L["Copy inherited permissions"], noText: L["Remove inherited permissions"], cancelText: L["Cancel"]);
        if (choice is null) return;
        await Run(() => Ops.BreakInheritanceAsync(Share, Path, copy: choice == true), L["Inheritance broken."]);
    }

    async Task RestoreInheritance()
    {
        var ok = await Dialogs.ShowMessageBoxAsync(L["Restore inheritance?"],
            L["This folder will receive the permissions of its parent folders again, in addition to its own."],
            yesText: L["Restore inheritance"], cancelText: L["Cancel"]);
        if (ok != true) return;
        await Run(() => Ops.RestoreInheritanceAsync(Share, Path), L["Inheritance restored."]);
    }

    async Task Run(Func<Task> action, string success)
    {
        busy = true;
        error = null;
        try
        {
            await action();
            states = await Repo.GetFolderStatesAsync(Share);
            Snack.Add(success, Severity.Success);
        }
        catch (AgentException e) { error = L.Translate(e.Message); }
        catch (HttpRequestException) { error = L["Agent unreachable."]; }
        busy = false;
    }
}
