@inject NasOperations Ops

@* Changement du mot de passe d'un utilisateur. *@
<MudDialog>
    <DialogContent>
        @if (error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@error</MudAlert>
        }
        <MudTextField @bind-Value="password" Label="@L["New password"]" InputType="InputType.Password" HelperText="@L["At least {0} characters", Rules.MinPasswordLength]" Disabled="busy" AutoFocus="true" />
        <MudTextField @bind-Value="confirm" Label="@L["Confirm password"]" InputType="InputType.Password" Disabled="busy" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()" Disabled="busy">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="busy">@(busy ? L["Saving…"] : L["Save"])</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter, EditorRequired] public string UserName { get; set; } = "";

    string password = "", confirm = "";
    string? error;
    bool busy;

    async Task Save()
    {
        error = null;
        if (password != confirm) { error = L["The two passwords differ."]; return; }
        busy = true;
        try
        {
            await Ops.SetPasswordAsync(UserName, password);
            Dialog.Close(DialogResult.Ok(true));
            return;
        }
        catch (AgentException e) { error = L.Translate(e.Message); }
        catch (HttpRequestException) { error = L["Agent unreachable."]; }
        busy = false;
    }
}
