@* Crée une partition dans l'espace non alloué d'un disque, puis la formate. Rien n'est effacé. *@
@inject AgentClient Agent
@inject DiskOperations Ops

<MudDialog>
    <DialogContent>
        @if (error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@error</MudAlert>
        }
        <MudText Class="mb-3">@L["Free space on {0}: {1}", Disk.Path, Fmt.Size(Disk.UnallocatedBytes, L.Lang)]</MudText>
        <MudNumericField T="double?" @bind-Value="sizeGb" Label="@L["Size (GB)"]" Min="0.1" Max="@maxGb" HideSpinButtons="true" Disabled="busy"
                         HelperText="@L["Leave empty to use all the free space."]" />
        <MudSelect T="string" @bind-Value="fs" Label="@L["File system"]" Class="mt-2" Disabled="busy">
            @foreach (var f in available)
            {
                <MudSelectItem T="string" Value="@f">@f</MudSelectItem>
            }
        </MudSelect>
        <MudTextField @bind-Value="label" Label="@(fs == "zfs" ? L["Pool name"] : L["Label (optional)"])" Class="mt-2" Immediate="true" Disabled="busy" HelperText="@(fs == "zfs" ? L["Name of the ZFS pool created on the partition (required)."] : L["1 to 11 characters: letters, digits, - and _."])" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()" Disabled="busy">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="@(busy || fs.Length == 0 || (fs == "zfs" && label.Trim().Length == 0))">@(busy ? L["In progress…"] : L["Create"])</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter, EditorRequired] public DiskInfo Disk { get; set; } = default!;

    IReadOnlyList<string> available = [];
    string fs = "", label = "";
    double? sizeGb;
    string? error;
    bool busy;
    double maxGb => Math.Floor(Disk.UnallocatedBytes / (double)(1L << 30) * 10) / 10;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            available = await Agent.GetFilesystemsAsync();
            fs = available.Contains("ext4") ? "ext4" : available.FirstOrDefault() ?? "";
        }
        catch (Exception e) when (e is AgentException or HttpRequestException) { error = e is AgentException a ? L.Translate(a.Message) : L["Agent unreachable."]; }
    }

    async Task Save()
    {
        error = null;
        busy = true;
        try
        {
            var l = label.Trim().Length == 0 ? null : label.Trim();
            long? mb = sizeGb is > 0 && sizeGb < maxGb ? (long)Math.Round(sizeGb.Value * 1024) : null;
            await Ops.CreatePartitionAsync(new CreatePartitionRequest(Disk.Path, mb, fs, l));
            Dialog.Close(DialogResult.Ok(true));
            return;
        }
        catch (AgentException e) { error = L.Translate(e.Message); }
        catch (HttpRequestException) { error = L["Agent unreachable."]; }
        busy = false;
    }
}
