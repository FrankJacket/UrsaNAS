@inject NasOperations Ops

@* Création d'un administrateur, ou changement de son mot de passe quand Existing est renseigné. *@
<MudDialog>
    <DialogContent>
        @if (error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@error</MudAlert>
        }
        <MudTextField @bind-Value="name" Label="Identifiant" Disabled="@(busy || Existing is not null)" AutoFocus="@(Existing is null)"
                      HelperText="Minuscules, chiffres, _ et -." />
        <MudTextField @bind-Value="password" Label="@(Existing is null ? "Mot de passe" : "Nouveau mot de passe")" InputType="InputType.Password"
                      Disabled="busy" AutoFocus="@(Existing is not null)" HelperText="@($"Au moins {Rules.MinPasswordLength} caractères.")" />
        <MudTextField @bind-Value="confirm" Label="Confirmer le mot de passe" InputType="InputType.Password" Disabled="busy" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()" Disabled="busy">Annuler</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="busy">@(busy ? "Enregistrement…" : "Enregistrer")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public string? Existing { get; set; }

    string name = "", password = "", confirm = "";
    string? error;
    bool busy;

    protected override void OnInitialized() => name = Existing ?? "";

    async Task Save()
    {
        error = null;
        if (password != confirm) { error = "Les deux mots de passe ne correspondent pas."; return; }
        busy = true;
        try
        {
            if (Existing is null) await Ops.CreateAdminAsync(name.Trim(), password);
            else await Ops.SetAdminPasswordAsync(Existing, password);
            Dialog.Close(DialogResult.Ok(true));
            return;
        }
        catch (AgentException e) { error = e.Message; }
        busy = false;
    }
}
