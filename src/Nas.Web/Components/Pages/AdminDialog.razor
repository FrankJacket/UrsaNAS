@inject NasOperations Ops

@* Création d'un administrateur, ou changement de son mot de passe quand Existing est renseigné. *@
<MudDialog>
    <DialogContent>
        @if (error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@error</MudAlert>
        }
        <MudTextField @bind-Value="name" Label="@L["Username"]" Disabled="@(busy || Existing is not null)" AutoFocus="@(Existing is null)"
                      HelperText="@L["Lowercase letters, digits, _ and -."]" />
        <MudTextField @bind-Value="password" Label="@(Existing is null ? L["Password"] : L["New password"])" InputType="InputType.Password"
                      Disabled="busy" AutoFocus="@(Existing is not null)" HelperText="@L["At least {0} characters.", Rules.MinPasswordLength]" />
        <MudTextField @bind-Value="confirm" Label="@L["Confirm password"]" InputType="InputType.Password" Disabled="busy" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()" Disabled="busy">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="busy">@(busy ? L["Saving…"] : L["Save"])</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public string? Existing { get; set; }

    string name = "", password = "", confirm = "";
    string? error;
    bool busy;

    protected override void OnInitialized() => name = Existing ?? "";

    async Task Save()
    {
        error = null;
        if (password != confirm) { error = L["The two passwords do not match."]; return; }
        busy = true;
        try
        {
            if (Existing is null) await Ops.CreateAdminAsync(name.Trim(), password);
            else await Ops.SetAdminPasswordAsync(Existing, password);
            Dialog.Close(DialogResult.Ok(true));
            return;
        }
        catch (AgentException e) { error = L.Translate(e.Message); }
        busy = false;
    }
}
