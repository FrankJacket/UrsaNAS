@inject NasOperations Ops

@* Création d'un utilisateur. Se ferme avec DialogResult.Ok(true) une fois le compte créé. *@
<MudDialog>
    <DialogContent>
        @if (error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@error</MudAlert>
        }
        <MudTextField @bind-Value="name" Label="Nom d'utilisateur" HelperText="Minuscules, chiffres, _ et -" Immediate="true" Disabled="busy" AutoFocus="true" />
        <MudTextField @bind-Value="password" Label="Mot de passe" InputType="InputType.Password" HelperText="@($"Au moins {Rules.MinPasswordLength} caractères")" Disabled="busy" />
        <MudTextField @bind-Value="confirm" Label="Confirmer le mot de passe" InputType="InputType.Password" Disabled="busy" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()" Disabled="busy">Annuler</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="busy">@(busy ? "Création…" : "Créer")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance Dialog { get; set; } = default!;

    string name = "", password = "", confirm = "";
    string? error;
    bool busy;

    async Task Save()
    {
        error = null;
        if (password != confirm) { error = "Les deux mots de passe sont différents."; return; }
        busy = true;
        try
        {
            await Ops.CreateUserAsync(name.Trim(), password);
            Dialog.Close(DialogResult.Ok(true));
            return;
        }
        catch (AgentException e) { error = e.Message; }
        catch (HttpRequestException) { error = "Agent injoignable."; }
        busy = false;
    }
}
