@page "/pools"
@inherits AutoRefreshBase
@inject AgentClient Agent
@inject NasOperations Ops
@inject IDialogService Dialogs
@inject ISnackbar Snack

@if (!InWindow) { <MudText Typo="Typo.h4" Class="mb-4">@L["ZFS pools"]</MudText> }
@if (error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@error</MudAlert>
}
<MudStack Row="true" Class="mb-4">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="Create">@L["Create a pool"]</MudButton>
</MudStack>

@if (loaded && error is null && pools.Count == 0)
{
    <MudText>@L["No pools. Create one from the free disks."]</MudText>
}
@foreach (var p in pools)
{
    var percent = p.SizeBytes == 0 ? 0 : 100.0 * p.AllocBytes / p.SizeBytes;
    var trim = TrimOf(p);
    <MudCard Class="mb-4">
        <MudCardHeader>
            <CardHeaderContent>
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h6">@p.Name</MudText>
                    <MudChip T="string" Size="Size.Small" Color="@HealthColor(p.Health)">@HealthText(p.Health)</MudChip>
                </MudStack>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FactCheck" OnClick="() => Scrub(p)">@L["Scrub"]</MudButton>
                <MudTooltip Text="@(trim is { CanStart: false } ? trim.Text : L["Tells the SSDs of the pool which space is no longer used."])">
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.CleaningServices" Disabled="@(trim is { CanStart: false })" OnClick="() => Trim(p)">@L["TRIM"]</MudButton>
                </MudTooltip>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="() => Destroy(p)">@L["Destroy"]</MudButton>
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardContent>
            <MudText Typo="Typo.body2">@L["{0} used of {1} — {2} free", Fmt.Size(p.AllocBytes, L.Lang), Fmt.Size(p.SizeBytes, L.Lang), Fmt.Size(p.FreeBytes, L.Lang)]</MudText>
            <MudProgressLinear Value="@percent" Color="@(percent > 90 ? Color.Error : percent > 80 ? Color.Warning : Color.Primary)" Class="my-2" />
            @if (!string.IsNullOrEmpty(p.Scan))
            {
                <MudText Typo="Typo.body2" Class="mb-1">@L["Scan: {0}", p.Scan]</MudText>
            }
            @if (trim is not null)
            {
                <MudText Typo="Typo.body2" Class="mb-1">@trim.Text</MudText>
            }
            @if (!string.IsNullOrEmpty(p.Errors))
            {
                <MudText Typo="Typo.body2" Class="mb-2">@L["Errors: {0}", p.Errors == "No known data errors" ? L["no known errors"] : p.Errors]</MudText>
            }
            <MudSimpleTable Dense="true" Hover="true">
                <thead><tr><th>@L["Device"]</th><th>@L["State"]</th><th>@L["Read"]</th><th>@L["Write"]</th><th>@L["Checksum"]</th></tr></thead>
                <tbody>
                @foreach (var d in p.Devices)
                {
                    <tr>
                        <td style="padding-left:@(16 + d.Depth * 24)px">@d.Name</td>
                        <td>@d.State</td><td>@d.Read</td><td>@d.Write</td><td>@d.Cksum</td>
                    </tr>
                }
                </tbody>
            </MudSimpleTable>
        </MudCardContent>
    </MudCard>
}

@code {
    /// <summary>Vrai quand la page est affichée dans une fenêtre du bureau : le titre est alors celui de la fenêtre.</summary>
    [CascadingParameter(Name = "InWindow")] bool InWindow { get; set; }

    IReadOnlyList<PoolInfo> pools = [];
    IReadOnlyList<DiskInfo> disks = [];
    IReadOnlyList<PoolTrimStatus> trims = [];
    string? error;
    bool loaded;

    static readonly DialogOptions Options = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true, BackdropClick = false };

    protected override async Task LoadAsync()
    {
        try
        {
            pools = await Agent.GetPoolsAsync();
            disks = await Agent.GetDisksAsync();
            error = null;
        }
        catch (AgentException e) { error = L.Translate(e.Message); }
        catch (HttpRequestException) { error = L["Agent unreachable: is the ursanas-agent service running?"]; }
        // Kept apart: without it, the pools are still shown, only the TRIM line is missing.
        try { trims = await Agent.GetTrimStatusAsync(); }
        catch (Exception e) when (e is AgentException or HttpRequestException) { trims = []; }
        loaded = true;
    }

    sealed record TrimLine(string Text, bool CanStart);

    /// <summary>The TRIM state of a pool in words; null when it is unknown.</summary>
    TrimLine? TrimOf(PoolInfo p)
    {
        if (trims.FirstOrDefault(t => t.Pool == p.Name) is not { } status) return null;
        var online = status.Devices.Where(d => d.Online).ToList();
        var supported = online.Where(d => d.State != TrimState.Unsupported).ToList();
        if (supported.Count == 0)
            return online.Count == 0 ? null : new(L["TRIM: not supported by the disks of this pool"], false);
        if (ScheduledTaskCoordinator.ReadTrim(status) == TrimOutcome.Running)
        {
            var done = (int)supported.Average(d => d.State == TrimState.Completed ? 100 : d.Percent ?? 0);
            return new(supported.Any(d => d.State == TrimState.Running) ? L["TRIM: in progress ({0}%)", done] : L["TRIM: paused ({0}%)", done], false);
        }
        if (supported.All(d => d.State == TrimState.Completed)) return new(L["TRIM: completed"], true);
        return new(supported.All(d => d.State == TrimState.Untrimmed) ? L["TRIM: not done"] : L["TRIM: not done on every disk"], true);
    }

    async Task Trim(PoolInfo p)
    {
        try
        {
            await Ops.TrimPoolAsync(p.Name);
            Snack.Add(L["TRIM of {0} started.", p.Name], Severity.Success);
            await LoadAsync();
        }
        catch (AgentException e) { Snack.Add(L.Translate(e.Message), Severity.Error); }
        catch (HttpRequestException) { Snack.Add(L["Agent unreachable."], Severity.Error); }
    }

    static Color HealthColor(string h) => h switch { "ONLINE" => Color.Success, "DEGRADED" => Color.Warning, _ => Color.Error };
    string HealthText(string h) => h switch { "ONLINE" => L["Online"], "DEGRADED" => L["Degraded"], "FAULTED" => L["Faulted"], _ => h };

    /// <summary>Un disque est libre s'il n'est monté nulle part et si aucun pool ne l'utilise (ou l'une de ses partitions).</summary>
    IReadOnlyList<DiskInfo> FreeDisks()
    {
        var used = pools.SelectMany(p => p.Devices).Select(d => d.Name).ToHashSet();
        return disks.Where(d => d.MountPoints.Count == 0 && !used.Any(u => u == d.Name || (u.StartsWith(d.Name, StringComparison.Ordinal) && u[d.Name.Length..].All(char.IsDigit)))).ToList();
    }

    async Task Create()
    {
        await LoadAsync();
        var parameters = new DialogParameters<PoolDialog> { { x => x.FreeDisks, FreeDisks() } };
        var dialog = await Dialogs.ShowAsync<PoolDialog>(L["Create a pool"], parameters, Options);
        if (await dialog.Result is { Canceled: false })
        {
            Snack.Add(L["Pool created."], Severity.Success);
            await LoadAsync();
        }
    }

    async Task Scrub(PoolInfo p)
    {
        try
        {
            await Ops.ScrubPoolAsync(p.Name);
            Snack.Add(L["Scrub of {0} started.", p.Name], Severity.Success);
            await LoadAsync();
        }
        catch (AgentException e) { Snack.Add(L.Translate(e.Message), Severity.Error); }
        catch (HttpRequestException) { Snack.Add(L["Agent unreachable."], Severity.Error); }
    }

    async Task Destroy(PoolInfo p)
    {
        var parameters = new DialogParameters<ConfirmNameDialog>
        {
            { x => x.Expected, p.Name },
            { x => x.Message, L["Pool {0} and all its data will be destroyed. This cannot be undone.", p.Name] },
            { x => x.ButtonText, "Destroy pool" },
            { x => x.Action, () => Ops.DestroyPoolAsync(p.Name) },
        };
        var dialog = await Dialogs.ShowAsync<ConfirmNameDialog>(L["Destroy {0}", p.Name], parameters, Options);
        if (await dialog.Result is { Canceled: false })
        {
            Snack.Add(L["Pool {0} destroyed.", p.Name], Severity.Success);
            await LoadAsync();
        }
    }
}
