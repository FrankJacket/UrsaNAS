@page "/alerts"
@inherits AutoRefreshBase
@inject Repo Repo
@inject NasOperations Ops
@inject AlertMonitor Monitor
@inject ISnackbar Snack

@if (!InWindow) { <MudText Typo="Typo.h4" Class="mb-4">@L["Alerts"]</MudText> }

<MudStack Row="true" Class="mb-4" AlignItems="AlignItems.Center">
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="CheckNow" Disabled="checking">@(checking ? L["Checking…"] : L["Check now"])</MudButton>
    <MudText Typo="Typo.body2">@L["Pools every minute, disks (SMART) every ten minutes. An alert is raised after two consecutive observations."]</MudText>
</MudStack>

@if (active.Count == 0 && loaded)
{
    <MudAlert Severity="Severity.Success" Class="mb-4">@L["No problem observed."]</MudAlert>
}
@foreach (var a in active)
{
    <MudAlert Severity="@(a.Severity == "critical" ? Severity.Error : Severity.Warning)" Class="mb-2">
        <b>@L.Translate(a.Title)</b> — @L["since {0}", Fmt.Dt(a.RaisedAt)]
        @if (!string.IsNullOrWhiteSpace(a.Detail)) { <div>@L.Translate(a.Detail)</div> }
    </MudAlert>
}

<MudTabs Class="desk-grow desk-tabs">
    <MudTabPanel Text="@L["History"]">
        <MudTable Items="history" Hover="true" Dense="true" Class="desk-grow">
            <HeaderContent><MudTh>@L["Opened"]</MudTh><MudTh>@L["Severity"]</MudTh><MudTh>@L["Alert"]</MudTh><MudTh>@L["Resolved"]</MudTh></HeaderContent>
            <RowTemplate>
                <MudTd>@Fmt.Dt(context.RaisedAt)</MudTd>
                <MudTd><MudChip T="string" Size="Size.Small" Color="@(context.Severity == "critical" ? Color.Error : Color.Warning)">@(context.Severity == "critical" ? L["Critical"] : L["Warning"])</MudChip></MudTd>
                <MudTd>@L.Translate(context.Title)</MudTd>
                <MudTd>@(context.ResolvedAt is { } r ? Fmt.Dt(r) : "—")</MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Class="pa-4">@L["No alerts yet."]</MudText></NoRecordsContent>
        </MudTable>

    </MudTabPanel>
    <MudTabPanel Text="@L["Email notifications"]">
        <MudPaper Class="pa-4 mb-8" Style="max-width:640px">
            @if (formError is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">@formError</MudAlert>
            }
            <MudSwitch T="bool" @bind-Value="mail.Enabled" Label="@L["Send an email for each alert"]" Color="Color.Primary" />
            <MudStack Row="true">
                <MudTextField @bind-Value="mail.Host" Label="@L["SMTP server"]" Style="flex:3" />
                <MudNumericField T="int" @bind-Value="mail.Port" Label="Port" Min="1" Max="65535" HideSpinButtons="true" Style="flex:1" />
            </MudStack>
            <MudSelect T="string" @bind-Value="mail.Security" Label="@L["Secure connection"]">
                <MudSelectItem T="string" Value="@("starttls")">STARTTLS (port 587)</MudSelectItem>
                <MudSelectItem T="string" Value="@("ssl")">SSL/TLS (port 465)</MudSelectItem>
                <MudSelectItem T="string" Value="@("none")">@L["None (local network only)"]</MudSelectItem>
            </MudSelect>
            <MudTextField @bind-Value="mail.User" Label="@L["Username (optional)"]" />
            <MudTextField @bind-Value="mail.Password" Label="@L["Password"]" InputType="InputType.Password"
                          HelperText="@(hasPassword ? L["A password is saved; leave empty to keep it."] : null)" />
            <UrsaMaskedField Value="@from" ValueChanged="OnFromChanged" Validator="ValidateFrom" Label="@L["Sender"]" />
            <MudTextField @bind-Value="mail.To" Label="@L["Recipients"]" HelperText="@L["Up to five addresses, separated by commas."]" Validation="@(new Func<string, string?>(ValidateRecipients))" />
            <MudStack Row="true" Class="mt-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="@(busy || !fromValid || !toValid)">@L["Save"]</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="SendTest" Disabled="busy">@(busy ? L["Sending…"] : L["Send a test email"])</MudButton>
            </MudStack>
            <MudText Typo="Typo.caption" Class="mt-2">@L["The test uses the saved settings. Alert emails are written in the language in use when you save."]</MudText>
        </MudPaper>

    </MudTabPanel>
</MudTabs>


@code {
    /// <summary>Vrai quand la page est affichée dans une fenêtre du bureau : le titre est alors celui de la fenêtre.</summary>
    [CascadingParameter(Name = "InWindow")] bool InWindow { get; set; }

    List<AlertRow> active = new(), history = new();
    /// <summary>Copie modifiable des réglages (MailSettings est un enregistrement immuable).</summary>
    sealed class MailForm
    {
        public bool Enabled { get; set; }
        public string Host { get; set; } = "";
        public int Port { get; set; } = 587;
        public string Security { get; set; } = "starttls";
        public string User { get; set; } = "";
        public string Password { get; set; } = "";
        public string From { get; set; } = "";
        public string To { get; set; } = "";

        public static MailForm Of(MailSettings s) => new()
        {
            Enabled = s.Enabled, Host = s.Host, Port = s.Port, Security = s.Security, User = s.User, Password = "", From = s.From, To = s.To,
        };

        public MailSettings ToSettings(string language) => new(Enabled, Host.Trim(), Port, Security, User.Trim(), Password, From.Trim(), To.Trim(), language);
    }

    MailForm mail = new();
    bool loaded, hasPassword, busy, checking, formLoaded;
    string? formError;

    // Reflètent mail.From/To : UrsaMaskedField doit être lié à un champ nullable à lui (jamais ramené à ""),
    // sinon la valeur poussée en retour diffère de celle, invalide, qu'il vient de refuser, et il se redessine
    // vide sans message — voir UrsaMaskedField.OnParametersSet.
    string? from;
    bool fromValid = true, toValid = true;

    protected override async Task LoadAsync()
    {
        active = await Repo.GetActiveAlertsAsync();
        history = await Repo.GetAlertHistoryAsync();
        if (!formLoaded) await LoadFormAsync(); // une seule fois : le rafraîchissement ne doit pas effacer ce qu'on tape
        loaded = true;
    }

    async Task LoadFormAsync()
    {
        var saved = await Repo.GetMailSettingsAsync();
        hasPassword = saved.Password.Length > 0;
        mail = MailForm.Of(saved);
        from = mail.From.Length > 0 ? mail.From : null;
        fromValid = toValid = true;
        formLoaded = true;
    }

    Task OnFromChanged(string? v)
    {
        from = v;
        mail.From = v ?? "";
        return Task.CompletedTask;
    }

    string? ValidateFrom(string text)
    {
        fromValid = MailRules.IsEmail(text);
        return fromValid ? null : L["Invalid sender address."];
    }

    string? ValidateRecipients(string text)
    {
        var parts = text.Split([',', ';', ' '], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length > 5)
        {
            toValid = false;
            return L["Enter 1 to 5 recipients."];
        }

        var bad = parts.FirstOrDefault(a => !MailRules.IsEmail(a));
        toValid = bad is null;
        return bad is null ? null : L["Invalid address: {0}.", bad];
    }

    async Task CheckNow()
    {
        checking = true;
        try
        {
            await Monitor.CheckNowAsync();
            await LoadAsync();
        }
        finally { checking = false; }
    }

    async Task Save()
    {
        formError = null;
        if (!fromValid || !toValid)
        {
            formError = L["Fix the highlighted fields before saving."];
            return;
        }

        busy = true;
        try
        {
            await Ops.SaveMailSettingsAsync(mail.ToSettings(L.Lang));
            await LoadFormAsync();
            Snack.Add(L["Settings saved."], Severity.Success);
        }
        catch (AgentException e) { formError = L.Translate(e.Message); }
        finally { busy = false; }
    }

    async Task SendTest()
    {
        formError = null;
        busy = true;
        try
        {
            await Ops.SendTestMailAsync();
            Snack.Add(L["Test email sent."], Severity.Success);
        }
        catch (AgentException e) { formError = L.Translate(e.Message); }
        finally { busy = false; }
    }
}
