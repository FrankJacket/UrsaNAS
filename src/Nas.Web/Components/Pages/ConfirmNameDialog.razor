@* Confirmation d'une action irréversible : il faut retaper le nom de l'objet. L'action s'exécute ici, l'erreur reste affichée dans la fenêtre. *@
<MudDialog>
    <DialogContent>
        @if (error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@error</MudAlert>
        }
        <MudText Class="mb-3">@Message</MudText>
        <MudTextField @bind-Value="typed" Label="@L["Type “{0}” to confirm", Expected]" Immediate="true" Disabled="busy" AutoFocus="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()" Disabled="busy">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="Confirm" Disabled="@(busy || typed != Expected)">@(busy ? L["In progress…"] : L[ButtonText])</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter, EditorRequired] public string Expected { get; set; } = "";
    [Parameter, EditorRequired] public string Message { get; set; } = "";
    [Parameter] public string ButtonText { get; set; } = "Delete";
    [Parameter, EditorRequired] public Func<Task> Action { get; set; } = default!;

    string typed = "";
    string? error;
    bool busy;

    async Task Confirm()
    {
        error = null;
        busy = true;
        try
        {
            await Action();
            Dialog.Close(DialogResult.Ok(true));
            return;
        }
        catch (AgentException e) { error = L.Translate(e.Message); }
        catch (HttpRequestException) { error = L["Agent unreachable."]; }
        busy = false;
    }
}
