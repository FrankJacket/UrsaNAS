@inject VmOperations Ops

@* Ajoute un disque, ou (si Resize est donné) agrandit un disque existant. *@
<MudDialog>
    <DialogContent>
        @if (error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@error</MudAlert>
        }
        @if (Resize is null)
        {
            <MudSelect T="string" @bind-Value="bus" Label="@L["Bus"]" Disabled="busy">
                @foreach (var b in Rules.VmDiskBuses) { <MudSelectItem T="string" Value="@b">@BusLabel(b)</MudSelectItem> }
            </MudSelect>
        }
        else
        {
            <MudText Class="mb-2">@L["Current size: {0} GB. A disk can only be made bigger; the system inside must then extend its partition.", Resize.SizeGb]</MudText>
        }
        <MudNumericField T="int" @bind-Value="sizeGb" Label="@L["Disk (GB)"]" Min="1" HideSpinButtons="true" Disabled="busy" Class="mt-2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()" Disabled="busy">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="busy">@(busy ? L["In progress…"] : Resize is null ? L["Add"] : L["Resize"])</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public VmDisk? Resize { get; set; }

    string bus = "virtio";
    int sizeGb = 32;
    string? error;
    bool busy;

    protected override void OnInitialized()
    {
        if (Resize is not null) sizeGb = (int)Resize.SizeGb + 10;
    }

    string BusLabel(string b) => b switch { "virtio" => "VirtIO (" + L["fastest, needs drivers on Windows"] + ")", "sata" => "SATA", _ => "SCSI" };

    async Task Save()
    {
        error = null;
        busy = true;
        try
        {
            if (Resize is null) await Ops.AddDiskAsync(Name, new AddVmDiskRequest(bus, sizeGb));
            else await Ops.ResizeDiskAsync(Name, new ResizeVmDiskRequest(Resize.Target, sizeGb));
            Dialog.Close(DialogResult.Ok(true));
            return;
        }
        catch (AgentException e) { error = L.Translate(e.Message); }
        catch (HttpRequestException) { error = L["Agent unreachable."]; }
        busy = false;
    }
}
