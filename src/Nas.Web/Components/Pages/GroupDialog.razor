@inject NasOperations Ops

@* Création d'un groupe ou changement de ses membres. *@
<MudDialog>
    <DialogContent>
        @if (error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@error</MudAlert>
        }
        <MudTextField @bind-Value="name" Label="@L["Group name"]" HelperText="@L["Lowercase letters, digits, _ and -"]" Immediate="true"
                      Disabled="@(busy || Existing is not null)" AutoFocus="@(Existing is null)" />
        <NamePicker Class="mt-3" Title="@L["Members"]" Items="Users" @bind-Selected="selected" Disabled="busy"
                    Empty="@L["Create a user first."]" HelperText="@L["Changes apply the next time a member connects."]" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()" Disabled="busy">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="busy">@(busy ? L["Applying…"] : L["Save"])</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public NasGroup? Existing { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<string> Users { get; set; } = [];

    string name = "";
    IReadOnlyCollection<string> selected = [];
    string? error;
    bool busy;

    protected override void OnInitialized()
    {
        if (Existing is null) return;
        name = Existing.Name;
        selected = Existing.Members.ToList();
    }

    async Task Save()
    {
        error = null;
        busy = true;
        try
        {
            var members = selected.OrderBy(m => m, StringComparer.Ordinal).ToList();
            if (Existing is null) await Ops.CreateGroupAsync(name.Trim(), members);
            else await Ops.SetGroupMembersAsync(Existing.Name, members);
            Dialog.Close(DialogResult.Ok(true));
            return;
        }
        catch (AgentException e) { error = L.Translate(e.Message); }
        catch (HttpRequestException) { error = L["Agent unreachable."]; }
        busy = false;
    }
}
