@inject AgentClient Agent

@* Choix d'un dossier de destination : même présentation que le gestionnaire de fichiers (source, puis partages ou disques montés au premier niveau) ; se ferme avec l'emplacement et le chemin choisis. *@
<MudDialog>
    <DialogContent>
        @if (error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@error</MudAlert>
        }
        <MudText Typo="Typo.body2" Class="mb-2">@Message</MudText>
        @if (Choosable)
        {
            <MudSelect T="string" Value="source" ValueChanged="s => SelectSource(s)" Label="@L["Source"]" Dense="true" Class="mb-2">
                <MudSelectItem T="string" Value="@("Shares")">@L["Shares"]</MudSelectItem>
                <MudSelectItem T="string" Value="@("Mounted drives")">@L["Mounted drives"]</MudSelectItem>
                <MudSelectItem T="string" Value="@("Remote")">@L["Remote"]</MudSelectItem>
            </MudSelect>
        }
        <MudPaper Elevation="0" Class="pick">
            @if (top.Children.Count == 0)
            {
                <MudText Typo="Typo.caption" Class="pa-3">@(source == "Remote" ? L["No remote storage mounted."] : source == "Shares" ? L["No share."] : L["No mounted drive."])</MudText>
            }
            <MudTreeView @key="treeKey" T="Node" Items="@TopItems()" ServerData="LoadChildren" SelectedValue="selected" SelectedValueChanged="Select"
                         ExpandOnDoubleClick="true" Hover="true" Dense="true">
                <ItemTemplate Context="item">
                    <MudTreeViewItem @bind-Expanded="@item.Expanded" Items="@item.Children" Value="@item.Value" CanExpand="@item.Expandable" Disabled="@IsBlocked(item.Value!)"
                                     Text="@item.Value!.Name" Icon="@NodeIcon(item.Value!)" IconColor="Color.Info" />
                </ItemTemplate>
            </MudTreeView>
        </MudPaper>
        <MudText Typo="Typo.caption" Class="mt-2">@L["Destination"] : <code>@(selected is null ? "" : (NasOperations.IsDisk(selected.Place) ? selected.Place : "/" + selected.Place) + (selected.Path.Length > 0 ? "/" + selected.Path : ""))</code></MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="() => Dialog.Close(DialogResult.Ok(new FolderPick(selected!.Place, selected.Path)))" Disabled="@(selected is null || IsBlocked(selected))">@L[ButtonText]</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .pick { border: 1px solid var(--mud-palette-lines-default); border-radius: 8px; max-height: 340px; min-height: 120px; overflow: auto; }
</style>

@code {
    [CascadingParameter] IMudDialogInstance Dialog { get; set; } = default!;
    /// <summary>L'emplacement (partage ou disque monté) ouvert au départ.</summary>
    [Parameter, EditorRequired] public string Share { get; set; } = "";
    /// <summary>Partages et disques montés (dossier, libellé) au choix : s'ils sont fournis, la fenêtre propose la liste « Source » ; sinon seul <c>Share</c> est proposé.</summary>
    [Parameter] public List<string> Shares { get; set; } = [];
    [Parameter] public List<(string Value, string Label)> Disks { get; set; } = [];
    /// <summary>Stockages distants montés (point de montage, libellé).</summary>
    [Parameter] public List<(string Value, string Label)> Remotes { get; set; } = [];
    [Parameter] public string Message { get; set; } = "";
    [Parameter] public string ButtonText { get; set; } = "Move";
    /// <summary>Dossier déplacé ou copié : ni lui ni ce qu'il contient ne peuvent servir de destination.</summary>
    [Parameter] public string Exclude { get; set; } = "";
    /// <summary>L'emplacement où se trouve <c>Exclude</c> (vide = <c>Share</c>) : il n'est exclu que dans celui-là.</summary>
    [Parameter] public string ExcludeLocation { get; set; } = "";

    sealed class Node
    {
        public string Place = "", Path = "", Name = "";
        public int Depth;
        public bool Loaded;
        public List<Node> Children = new();
        TreeItemData<Node>? data;
        public TreeItemData<Node> Data => data ??= new() { Value = this, Text = Name, Expandable = true };
        public bool Expanded { get => Data.Expanded; set => Data.Expanded = value; }
    }

    readonly Node top = new() { Depth = -1, Loaded = true };
    int treeKey;
    IReadOnlyCollection<TreeItemData<Node>> TopItems() => top.Children.Select(c => c.Data).ToList();
    void Select(Node? n) { if (n is not null && !IsBlocked(n)) selected = n; }
    string NodeIcon(Node n) => n.Depth > 0 ? Icons.Material.Filled.Folder : Remotes.Any(r => r.Value == n.Place) ? Icons.Material.Filled.CloudQueue : NasOperations.IsDisk(n.Place) ? Icons.Material.Filled.Storage : Icons.Material.Filled.FolderShared;

    async Task<IReadOnlyCollection<TreeItemData<Node>>> LoadChildren(Node? parent)
    {
        if (parent is null) return TopItems();
        if (!parent.Loaded) await Load(parent);
        return parent.Children.Select(c => c.Data).ToList();
    }
    Node? selected;
    string? error;
    string source = "Shares";

    bool Choosable => Shares.Count > 0 || Disks.Count > 0 || Remotes.Count > 0;

    bool IsBlocked(Node n) => Exclude.Length > 0 && n.Place == (ExcludeLocation.Length > 0 ? ExcludeLocation : Share) && (n.Path == Exclude || n.Path.StartsWith(Exclude + "/", StringComparison.Ordinal));

    protected override async Task OnInitializedAsync()
        => await SelectSource(Remotes.Any(r => r.Value == Share) ? "Remote" : NasOperations.IsDisk(Share) ? "Mounted drives" : "Shares", Share);

    IEnumerable<(string Place, string Label)> Places() => !Choosable ? [(Share, Share)] : source switch
    {
        "Shares" => Shares.Select(s => (s, s)),
        "Mounted drives" => Disks.Select(d => (d.Value, d.Label)),
        _ => Remotes.Select(d => (d.Value, d.Label)),
    };

    async Task SelectSource(string value, string? place = null)
    {
        source = value;
        error = null;
        selected = null;
        top.Children = Places().Select(p => new Node { Place = p.Place, Name = p.Label, Depth = 0 }).ToList();
        treeKey++;
        // Seul l'emplacement d'origine est ouvert ; changer de source ne lit rien tant qu'on n'ouvre pas un dossier.
        var wanted = place is null ? null : top.Children.FirstOrDefault(c => c.Place == place);
        selected = wanted ?? top.Children.FirstOrDefault();
        if (wanted is null) return;
        await Load(wanted);
        wanted.Expanded = true;
    }

    async Task Load(Node n)
    {
        try
        {
            var listing = await Agent.GetFoldersAsync(n.Place, n.Path);
            n.Children = listing.Folders.Select(f => new Node { Place = n.Place, Name = f.Name, Path = n.Path.Length == 0 ? f.Name : n.Path + "/" + f.Name, Depth = n.Depth + 1 }).ToList();
            n.Data.Children = n.Children.Select(c => c.Data).ToList();
            n.Loaded = true;
        }
        catch (AgentException e) { error = L.Translate(e.Message); }
        catch (HttpRequestException) { error = L["Agent unreachable."]; }
    }
}
