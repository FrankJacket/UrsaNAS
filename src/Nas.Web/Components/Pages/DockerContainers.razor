@page "/docker/containers"
@inherits AutoRefreshBase
@inject AgentClient Agent
@inject DockerOperations Ops
@inject IDialogService Dialogs
@inject ISnackbar Snack

@if (!InWindow)
{
    <MudText Typo="Typo.h4" Class="mb-4">@L["Containers"]</MudText>
}

@if (error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@error <MudLink Href="@(DockNav is null ? "/docker" : null)" OnClick="@(() => DockNav?.Go("status"))">@L["Docker status"]</MudLink></MudAlert>
}

<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="RunNew" Class="mb-4">@L["Run a container"]</MudButton>

@if (loaded && containers.Count == 0)
{
    <MudText Class="pa-4">@L["No containers."]</MudText>
}
else if (!loaded)
{
    <MudProgressLinear Indeterminate="true" />
}
<MudExpansionPanels MultiExpansion="true" Class="desk-grow" Style="overflow:auto">
    @foreach (var c in containers)
    {
        var st = stats.GetValueOrDefault(c.Id);
        <MudExpansionPanel @key="c.Id" Dense="true">
            <TitleContent>
                <div class="ctn-head">
                    <div>
                        <b>@c.Name</b>
                        @if (c.Project is not null) { <MudChip T="string" Size="Size.Small" Class="ml-2">@c.Project</MudChip> }
                    </div>
                    <div class="ctn-image">@c.Image</div>
                    <div>
                        <MudChip T="string" Size="Size.Small" Color="@StateColor(c.State)">@c.State</MudChip>
                        <MudText Typo="Typo.caption" Class="d-block">@c.Status</MudText>
                    </div>
                    <div>@(st is null ? "" : $"CPU {st.CpuPercent:0.0} %")</div>
                    <div>@(st is null ? "" : Fmt.Size(st.MemUsedBytes, L.Lang))</div>
                </div>
            </TitleContent>
            <ChildContent>
                <MudSimpleTable Dense="true" Elevation="0" Class="net-details">
                    <tbody>
                        <tr><th>@L["Image"]</th><td>@c.Image</td></tr>
                        <tr><th>@L["Ports"]</th><td>@(c.Ports.Length > 0 ? c.Ports : L["None published: reach the container at its IP address."])</td></tr>
                        @foreach (var n in c.Networks ?? [])
                        {
                            <tr><th>@L["Network"]</th><td><b>@n.Network</b></td></tr>
                            <tr><th>@L["IP address"]</th><td>@(n.Ip ?? "--")</td></tr>
                            @if (n.Ipv6 is not null) { <tr><th>IPv6</th><td>@n.Ipv6</td></tr> }
                            <tr><th>@L["Gateway"]</th><td>@(n.Gateway ?? "--")</td></tr>
                            @if (n.Mac is not null) { <tr><th>MAC</th><td>@n.Mac</td></tr> }
                        }
                        <tr>
                            <th>@L["Operation"]</th>
                            <td style="white-space:nowrap">
                                @if (c.State == "running")
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="busy" OnClick='() => Act(c, "stop", L["Container stopped."])'>@L["Stop"]</MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="busy" OnClick='() => Act(c, "restart", L["Container restarted."])'>@L["Restart"]</MudButton>
                                }
                                else
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Disabled="busy" OnClick='() => Act(c, "start", L["Container started."])'>@L["Start"]</MudButton>
                                }
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit" Disabled="busy" OnClick="() => Edit(c)">@L["Edit"]</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Article" OnClick="() => Logs(c)">@L["Logs"]</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" Disabled="busy" OnClick="() => Delete(c)">@L["Delete"]</MudButton>
                            </td>
                        </tr>
                    </tbody>
                </MudSimpleTable>
            </ChildContent>
        </MudExpansionPanel>
    }
</MudExpansionPanels>

@code {
    /// <summary>Navigation interne de la fenêtre Docker ; absente quand la page est ouverte seule.</summary>
    [CascadingParameter] DockerNav? DockNav { get; set; }

    /// <summary>Vrai quand la page est affichée dans une fenêtre du bureau : le titre est alors celui de la fenêtre.</summary>
    [CascadingParameter(Name = "InWindow")] bool InWindow { get; set; }

    IReadOnlyList<ContainerInfo> containers = [];
    Dictionary<string, ContainerStats> stats = new();
    string? error;
    bool loaded, busy;

    protected override async Task LoadAsync()
    {
        try
        {
            containers = (await Agent.GetContainersAsync()).OrderBy(c => c.Name, StringComparer.OrdinalIgnoreCase).ToList();
            error = null;
            try
            {
                // Les statistiques sont indexées par identifiant abrégé (12 caractères) : on les rattache aux conteneurs par préfixe.
                var s = await Agent.GetContainerStatsAsync();
                stats = containers.Select(c => (c, s: s.FirstOrDefault(x => c.Id.StartsWith(x.Id, StringComparison.Ordinal) || x.Id.StartsWith(c.Id, StringComparison.Ordinal))))
                    .Where(p => p.s is not null).ToDictionary(p => p.c.Id, p => p.s!);
            }
            catch (Exception e) when (e is AgentException or HttpRequestException) { stats = new(); } // les statistiques sont facultatives
        }
        catch (AgentException e) { error = L.Translate(e.Message); }
        catch (HttpRequestException) { error = L["Agent unreachable: is the ursanas-agent service running?"]; }
        loaded = true;
    }

    static Color StateColor(string s) => s switch { "running" => Color.Success, "exited" or "created" => Color.Default, _ => Color.Warning };

    async Task Run(Func<Task> action, string success)
    {
        busy = true;
        try { await action(); Snack.Add(success, Severity.Success); }
        catch (AgentException e) { Snack.Add(L.Translate(e.Message), Severity.Error); }
        catch (HttpRequestException) { Snack.Add(L["Agent unreachable."], Severity.Error); }
        busy = false;
        await LoadAsync();
    }

    Task Act(ContainerInfo c, string action, string success) => Run(() => Ops.ContainerAsync(c.Id, c.Name, action), success);

    async Task Delete(ContainerInfo c)
    {
        var ok = await Dialogs.ShowMessageBoxAsync(L["Delete {0}?", c.Name],
            L["The container is removed. Its volumes and the files it wrote in mounted folders are kept. A running container must be stopped first."],
            yesText: L["Delete"], cancelText: L["Cancel"]);
        if (ok == true) await Act(c, "remove", L["{0} deleted.", c.Name]);
    }

    async Task Logs(ContainerInfo c)
    {
        var parameters = new DialogParameters<ContainerLogsDialog> { { x => x.Id, c.Id }, { x => x.Name, c.Name } };
        await Dialogs.ShowAsync<ContainerLogsDialog>(L["Logs of {0}", c.Name], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true });
    }

    async Task Edit(ContainerInfo c)
    {
        var parameters = new DialogParameters<ContainerRunDialog> { { x => x.ContainerId, c.Id }, { x => x.ContainerName, c.Name } };
        var dialog = await Dialogs.ShowAsync<ContainerRunDialog>(L["Edit {0}", c.Name], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true, BackdropClick = false });
        if (await dialog.Result is { Canceled: false })
        {
            Snack.Add(L["Container updated."], Severity.Success);
            await LoadAsync();
        }
    }

    async Task RunNew()
    {
        var dialog = await Dialogs.ShowAsync<ContainerRunDialog>(L["Run a container"], new DialogParameters(),
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true, BackdropClick = false });
        if (await dialog.Result is { Canceled: false })
        {
            Snack.Add(L["Container started."], Severity.Success);
            await LoadAsync();
        }
    }
}

<style>
    .ctn-head { display: grid; grid-template-columns: minmax(120px, 1.2fr) minmax(120px, 1.4fr) minmax(110px, 1fr) 90px 90px; gap: 12px; align-items: center; width: 100%; }
    .ctn-image { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .net-details th { width: 130px; text-align: left; font-weight: 500; color: var(--mud-palette-text-secondary); vertical-align: top; }
</style>
