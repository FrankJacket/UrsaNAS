@page "/"
@implements IDisposable
@inject DesktopState Desk
@inject DockerAvailability Docker
@inject AlertState Alerts
@inject ThemeState Theme
@inject WallpaperStore Walls

<PageTitle>UrsaNAS</PageTitle>

@* Fond d'écran : une couche fixe derrière les icônes. Par défaut un dégradé aux couleurs du thème ; un fond choisi par
   l'utilisateur se branche en définissant --desk-wallpaper (image ou dégradé). Les icônes restent lisibles dessus. *@
<div class="desk-wallpaper" style="@WallpaperStyle"></div>

<div class="desk-page">
    @foreach (var group in DesktopState.Apps.Where(a => !a.NeedsDocker || Docker.Ready).GroupBy(a => a.Category))
    {
        var apps = group.ToList();
        <section class="desk-section">
            <h2 class="desk-category">@L[group.Key]</h2>
            <div class="desk-grid" style="--cols:@Math.Min(apps.Count, 4)">
                @foreach (var app in apps)
                {
                    var a = app;
                    var (c1, c2) = Colors(a);
                    <button type="button" class="desk-icon" @onclick="() => OpenApp(a)">
                        <MudBadge Content="@AlertCount(a)" Visible="@(AlertCount(a) > 0)" Color="@(Alerts.CriticalCount > 0 ? Color.Error : Color.Warning)" Overlap="true">
                            <span class="desk-tile" style="--c1:@c1; --c2:@c2"><MudIcon Icon="@a.Icon" Style="font-size:inherit; color:inherit" /></span>
                        </MudBadge>
                        <span class="desk-label">@L[a.Title]</span>
                    </button>
                }
            </div>
        </section>
    }
</div>

<style>
    .desk-wallpaper {
        position: fixed; inset: 0; z-index: -1;
        background: var(--desk-wallpaper, linear-gradient(160deg, color-mix(in srgb, var(--mud-palette-primary) 35%, #0b0b1a), var(--mud-palette-primary)));
        background-size: cover; background-position: center;
    }
    .desk-page { --tile: 76px; --item: 116px; display: flex; flex-wrap: wrap; align-items: flex-start; gap: 24px; padding: 8px 4px; }
    @@media (min-width: 1800px) { .desk-page { --tile: 96px; --item: 144px; gap: 32px; } }

    /* Chaque groupe est un panneau translucide : lisible sur n'importe quel fond. */
    .desk-section {
        padding: 14px 16px 18px; border-radius: 22px; color: #fff;
        background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.22);
        backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    }
    .desk-category { margin: 0 4px 10px; font-size: .75rem; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; opacity: .9; text-shadow: 0 1px 3px rgba(0,0,0,.5); }
    .desk-grid { display: grid; grid-template-columns: repeat(var(--cols), var(--item)); gap: 6px; }

    .desk-icon {
        display: flex; flex-direction: column; align-items: center; justify-content: flex-start; gap: 10px; padding: 10px 4px 8px;
        border: 0; border-radius: 16px; background: transparent; color: inherit; font: inherit; cursor: pointer;
    }
    .desk-icon:hover, .desk-icon:focus-visible { background: rgba(255,255,255,.18); outline: none; }
    .desk-icon:active .desk-tile { transform: scale(.95); }
    .desk-tile {
        display: grid; place-items: center; width: var(--tile); height: var(--tile); border-radius: 22%;
        font-size: calc(var(--tile) * .56); color: #fff;
        background: linear-gradient(150deg, var(--c1), var(--c2));
        box-shadow: 0 6px 14px rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.4);
        transition: transform .12s ease;
    }
    .desk-icon:hover .desk-tile { transform: translateY(-2px) scale(1.05); }
    .desk-label { font-size: .9rem; line-height: 1.2; text-align: center; text-shadow: 0 1px 3px rgba(0,0,0,.65); }
</style>

@code {
    // Une teinte par groupe ; quelques fonctions ont la leur.
    static readonly Dictionary<string, (string, string)> CategoryColors = new()
    {
        ["System"] = ("#74a0ff", "#3b5bdb"),
        ["Storage"] = ("#ffb35c", "#f76707"),
        ["Sharing"] = ("#4be0b5", "#0ca678"),
        ["Virtualization"] = ("#b9a3ff", "#7048e8"),
        ["Accounts"] = ("#ff8fb8", "#d6336c"),
        ["Monitoring"] = ("#ff9a9a", "#e03131"),
    };

    static readonly Dictionary<string, (string, string)> AppColors = new()
    {
        ["docker"] = ("#4dabf7", "#1971c2"),
        ["terminal"] = ("#495057", "#16181b"),
    };

    static (string, string) Colors(DesktopApp app) =>
        AppColors.TryGetValue(app.Id, out var c) ? c : CategoryColors.GetValueOrDefault(app.Category, ("#adb5bd", "#495057"));

    protected override void OnInitialized()
    {
        Docker.Changed += OnChanged; // l'icône Docker apparaît ou disparaît avec l'état du service
        Alerts.Changed += OnChanged;
        Theme.Changed += OnChanged; // le fond d'écran change depuis la fenêtre Apparence
    }

    void OnChanged() => InvokeAsync(StateHasChanged);

    /// <summary>Valeur de --desk-wallpaper pour le fond choisi ; vide = dégradé par défaut aux couleurs du thème.</summary>
    string? WallpaperStyle =>
        Theme.Wallpaper == Wallpaper.CustomId && Walls.Current() is not null ? $"--desk-wallpaper:url(/wallpaper?v={Walls.Version})"
        : Wallpaper.Find(Theme.Wallpaper) is { } w ? $"--desk-wallpaper:{w.Css}"
        : null;

    int AlertCount(DesktopApp app) => app.Id == "alerts" ? Alerts.Count : 0;

    // Chaque fonction s'ouvre dans une fenêtre flottante.
    void OpenApp(DesktopApp app)
    {
        Desk.Open(app);
    }

    public void Dispose()
    {
        Docker.Changed -= OnChanged;
        Alerts.Changed -= OnChanged;
        Theme.Changed -= OnChanged;
    }
}
