<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="/" />
    <title>UrsaNAS</title>
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" rel="stylesheet" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>
<body>
    <Routes @rendermode="PageRenderMode" InitialTheme="@theme" />
    <script src="_framework/blazor.web.js"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script>
        // Mémorise le thème choisi pour ce navigateur (relu côté serveur au chargement suivant).
        function ursanasSetTheme(value) {
            document.cookie = 'ursanas-theme=' + value + '; path=/; max-age=31536000; SameSite=Lax';
        }
        // Insère du texte à la position du curseur d'une zone de texte et renvoie son nouveau contenu.
        function ursanasInsertAtCursor(id, text) {
            const t = document.getElementById(id);
            if (!t) return null;
            const s = t.selectionStart ?? t.value.length;
            t.setRangeText(text, s, t.selectionEnd ?? s, 'end');
            t.dispatchEvent(new Event('input', { bubbles: true }));
            return t.value;
        }
    </script>
</body>
</html>

@code {
    [CascadingParameter] HttpContext? HttpContext { get; set; }

    /// <summary>Connexion et installation sont rendues côté serveur sans circuit : le cookie de session doit être posé par une vraie réponse HTTP.</summary>
    IComponentRenderMode? PageRenderMode =>
        HttpContext?.Request.Path.StartsWithSegments("/login") == true || HttpContext?.Request.Path.StartsWithSegments("/setup") == true
            ? null : RenderMode.InteractiveServer;

    string theme => HttpContext?.Request.Cookies["ursanas-theme"] == "dark" ? "dark" : "light";
}
